@model LCM.Domain.Entities.DigitalLabelSpec
@{
    ViewData["Title"] = "Etiket Özelliği Detay";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h5 class="fw-bold mb-1">@Model.EtiketAdi</h5>
                        <span class="badge rounded-pill px-3 py-2"
                              style="background:#eff6ff; color:#2563eb; font-size:0.82rem;">
                            @Model.EtiketTip?.EtiketTipi
                        </span>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/DigitalLabelSpec/Edit/@Model.Id"
                           class="btn btn-sm btn-primary" style="border-radius:8px;">
                            <i class="bi bi-pencil me-1"></i>Düzenle
                        </a>
                    }
                </div>

                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Inch))
                    {
                        <div class="col-md-4">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">INCH</div>
                                <div style="font-weight:600;">@Model.Inch"</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.DPI))
                    {
                        <div class="col-md-4">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">DPI</div>
                                <div style="font-weight:600;">@Model.DPI</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TahminiPilOmru))
                    {
                        <div class="col-md-4">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">PİL ÖMRÜ</div>
                                <div style="font-weight:600;">@Model.TahminiPilOmru</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Olculer))
                    {
                        <div class="col-md-6">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">ÖLÇÜLER</div>
                                <div style="font-weight:600;">@Model.Olculer</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.DayanabildigiSicaklik))
                    {
                        <div class="col-md-6">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">DAYANDIĞI SICAKLIK</div>
                                <div style="font-weight:600;">@Model.DayanabildigiSicaklik</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ActiveDisplayArea))
                    {
                        <div class="col-md-6">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">ACTIVE DISPLAY AREA</div>
                                <div style="font-weight:600;">@Model.ActiveDisplayArea</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Dimensions))
                    {
                        <div class="col-md-6">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">DIMENSIONS</div>
                                <div style="font-weight:600;">@Model.Dimensions</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.PageSwitch))
                    {
                        <div class="col-md-6">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">PAGE SWITCH</div>
                                <div style="font-weight:600;">@Model.PageSwitch</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ViewingAngle))
                    {
                        <div class="col-md-6">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.2rem;">VIEWING ANGLE</div>
                                <div style="font-weight:600;">@Model.ViewingAngle</div>
                            </div>
                        </div>
                    }

                    <!-- Renkler -->
                    @if (!string.IsNullOrEmpty(Model.DesteklenenRenkler))
                    {
                        <div class="col-12">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.5rem;">DESTEKLENEN RENKLER</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var renk in Model.DesteklenenRenkler.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        var renkAdi = renk.Trim().ToLower();
                                        var renkKodu = RenkKodu(renkAdi);
                                        <span style="display:inline-flex; align-items:center; gap:6px;
                                                             background:white; border:1px solid #e0e0e0;
                                                             border-radius:20px; padding:4px 12px; font-size:0.82rem;">
                                            <span style="width:12px; height:12px; border-radius:50%;
                                                                 background:@renkKodu; border:1px solid #ddd;
                                                                 display:inline-block;"></span>
                                            @renk.Trim()
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.LedDesteklenenRenkler))
                    {
                        <div class="col-12">
                            <div style="background:#f8fafc; border-radius:10px; padding:0.9rem;">
                                <div style="font-size:0.72rem; color:#888; margin-bottom:0.5rem;">LED DESTEKLENEN RENKLER</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var renk in Model.LedDesteklenenRenkler.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        var renkAdi = renk.Trim().ToLower();
                                        var renkKodu = RenkKodu(renkAdi);
                                        <span style="display:inline-flex; align-items:center; gap:6px;
                                                             background:white; border:1px solid #e0e0e0;
                                                             border-radius:20px; padding:4px 12px; font-size:0.82rem;">
                                            <span style="width:12px; height:12px; border-radius:50%;
                                                                 background:@renkKodu; border:1px solid #ddd;
                                                                 display:inline-block;"></span>
                                            @renk.Trim()
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <a href="/DigitalLabelSpec/Index" class="btn btn-light btn-sm" style="border-radius:8px;">
                        <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string RenkKodu(string renk) => renk switch
    {
        "kırmızı" or "kirmizi" or "red" => "#ef4444",
        "sarı" or "sari" or "yellow" => "#eab308",
        "siyah" or "black" => "#111111",
        "beyaz" or "white" => "#f9fafb",
        "mavi" or "blue" => "#3b82f6",
        "yeşil" or "yesil" or "green" => "#22c55e",
        "turuncu" or "orange" => "#f97316",
        _ => "#94a3b8"
    };
}