@model List<LCM.Domain.Entities.DigitalLabelSpec>
@{
    ViewData["Title"] = "Dijital Etiket Özellikleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-0">Dijital Etiket Özellikleri</h5>
        <small class="text-muted">ESL etiketlerinin teknik özellikleri</small>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a href="/DigitalLabelSpec/Create" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i>Yeni Ekle
        </a>
    }
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius:14px;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="fw-bold mb-0">@item.EtiketAdi</h6>
                            <small class="text-muted">@item.Inch inch</small>
                        </div>
                        <span class="badge rounded-pill px-2 py-1"
                              style="background:#eff6ff; color:#2563eb; font-size:0.75rem;">
                            @item.EtiketTip?.EtiketTipi
                        </span>
                    </div>

                    <!-- Renkler -->
                    @if (!string.IsNullOrEmpty(item.DesteklenenRenkler))
                    {
                        <div class="mb-3">
                            <div style="font-size:0.72rem; color:#888; margin-bottom:0.4rem;">DESTEKLENEN RENKLER</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var renk in item.DesteklenenRenkler.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    var renkAdi = renk.Trim().ToLower();
                                    var renkKodu = RenkKodu(renkAdi);
                                    <span style="display:inline-flex; align-items:center; gap:4px;
                                                             background:#f8fafc; border-radius:20px;
                                                             padding:2px 8px; font-size:0.75rem;">
                                        <span style="width:10px; height:10px; border-radius:50%;
                                                                 background:@renkKodu; border:1px solid #ddd;
                                                                 display:inline-block;"></span>
                                        @renk.Trim()
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <!-- Teknik Bilgiler -->
                    <div style="font-size:0.8rem; color:#555; line-height:1.8;">
                        @if (!string.IsNullOrEmpty(item.Olculer))
                        {
                            <div><span style="color:#aaa;">Ölçüler:</span> @item.Olculer</div>
                        }
                        @if (!string.IsNullOrEmpty(item.DPI))
                        {
                            <div><span style="color:#aaa;">DPI:</span> @item.DPI</div>
                        }
                        @if (!string.IsNullOrEmpty(item.TahminiPilOmru))
                        {
                            <div><span style="color:#aaa;">Pil Ömrü:</span> @item.TahminiPilOmru</div>
                        }
                        @if (!string.IsNullOrEmpty(item.DayanabildigiSicaklik))
                        {
                            <div><span style="color:#aaa;">Sıcaklık:</span> @item.DayanabildigiSicaklik</div>
                        }
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="d-flex gap-2 mt-3 pt-3" style="border-top:1px solid #f0f0f0;">
                            <a href="/DigitalLabelSpec/Detail/@item.Id"
                               class="btn btn-sm btn-outline-secondary"
                               style="border-radius:8px; flex:1;">
                                <i class="bi bi-eye me-1"></i>Detay
                            </a>
                            <a href="/DigitalLabelSpec/Edit/@item.Id"
                               class="btn btn-sm btn-outline-primary"
                               style="border-radius:8px; flex:1;">
                                <i class="bi bi-pencil me-1"></i>Düzenle
                            </a>
                            <form method="post" action="/DigitalLabelSpec/Delete/@item.Id"
                                  data-noloading="true">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        onclick="openConfirm(this.closest('form'))"
                                        class="btn btn-sm btn-outline-danger"
                                        style="border-radius:8px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="mt-3 pt-3" style="border-top:1px solid #f0f0f0;">
                            <a href="/DigitalLabelSpec/Detail/@item.Id"
                               class="btn btn-sm btn-outline-secondary w-100"
                               style="border-radius:8px;">
                                <i class="bi bi-eye me-1"></i>Detay
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-cpu display-6 d-block mb-2"></i>
            Henüz etiket özelliği eklenmemiş.
        </div>
    }
</div>

@functions {
    string RenkKodu(string renk) => renk switch
    {
        "kırmızı" or "kirmizi" or "red" => "#ef4444",
        "sarı" or "sari" or "yellow" => "#eab308",
        "siyah" or "black" => "#111111",
        "beyaz" or "white" => "#f9fafb",
        "mavi" or "blue" => "#3b82f6",
        "yeşil" or "yesil" or "green" => "#22c55e",
        "turuncu" or "orange" => "#f97316",
        _ => "#94a3b8"
    };
}