@model LCM.Web.ViewModels.DigitalLabelSpecViewModel
@{
    ViewData["Title"] = "Yeni Dijital Etiket Özelliği";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-1">Yeni Dijital Etiket Özelliği</h5>
                <p class="text-muted mb-4" style="font-size:0.88rem;">
                    ESL etiketinin teknik özelliklerini gir
                </p>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" style="font-size:0.88rem;"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Etiket Adı</label>
                            <input asp-for="EtiketAdi" class="form-control" style="border-radius:10px;" />
                            <span asp-validation-for="EtiketAdi" class="text-danger" style="font-size:0.82rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Etiket Tipi</label>
                            <select asp-for="EtiketTipId" asp-items="ViewBag.EtiketTipleri"
                                    class="form-select" style="border-radius:10px;">
                                <option value="">— Seçin —</option>
                            </select>
                            <span asp-validation-for="EtiketTipId" class="text-danger" style="font-size:0.82rem;"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Inch</label>
                            <input asp-for="Inch" class="form-control" style="border-radius:10px;" placeholder="Örn: 2.9" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-500" style="font-size:0.88rem;">DPI</label>
                            <input asp-for="DPI" class="form-control" style="border-radius:10px;" placeholder="Örn: 212" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Tahmini Pil Ömrü</label>
                            <input asp-for="TahminiPilOmru" class="form-control" style="border-radius:10px;" placeholder="Örn: 5 yıl" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Ölçüler</label>
                            <input asp-for="Olculer" class="form-control" style="border-radius:10px;" placeholder="Örn: 74.2 x 99.3 mm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Dayanabildiği Sıcaklık</label>
                            <input asp-for="DayanabildigiSicaklik" class="form-control" style="border-radius:10px;" placeholder="Örn: -20°C ~ 60°C" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Active Display Area</label>
                            <input asp-for="ActiveDisplayArea" class="form-control" style="border-radius:10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Dimensions</label>
                            <input asp-for="Dimensions" class="form-control" style="border-radius:10px;" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Page Switch</label>
                            <input asp-for="PageSwitch" class="form-control" style="border-radius:10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Viewing Angle</label>
                            <input asp-for="ViewingAngle" class="form-control" style="border-radius:10px;" />
                        </div>
                    </div>

                    <!-- Desteklenen Renkler -->
                    <div class="mb-3">
                        <label class="form-label fw-500" style="font-size:0.88rem;">Desteklenen Renkler</label>
                        <div style="background:#f8fafc; border-radius:10px; padding:1rem;">
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var renk in ViewBag.Renkler as List<(string Ad, string Kod)>)
                                {
                                    <label style="display:inline-flex; align-items:center; gap:8px; cursor:pointer;
                                   background:white; border:1px solid #e0e0e0; border-radius:20px;
                                   padding:6px 14px; font-size:0.85rem; user-select:none;"
                                           class="renk-secici">
                                        <input type="checkbox" name="DesteklenenRenkler" value="@renk.Ad"
                                               style="display:none;"
                                               @(Model.DesteklenenRenkler.Contains(renk.Ad) ? "checked" : "") />
                                        <span style="width:14px; height:14px; border-radius:50%;
                                     background:@renk.Kod; border:1px solid #ddd;
                                     display:inline-block; flex-shrink:0;"></span>
                                        @renk.Ad
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- LED Desteklenen Renkler -->
                    <div class="mb-4">
                        <label class="form-label fw-500" style="font-size:0.88rem;">LED Desteklenen Renkler</label>
                        <div style="background:#f8fafc; border-radius:10px; padding:1rem;">
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var renk in ViewBag.Renkler as List<(string Ad, string Kod)>)
                                {
                                    <label style="display:inline-flex; align-items:center; gap:8px; cursor:pointer;
                                   background:white; border:1px solid #e0e0e0; border-radius:20px;
                                   padding:6px 14px; font-size:0.85rem; user-select:none;"
                                           class="renk-secici">
                                        <input type="checkbox" name="LedDesteklenenRenkler" value="@renk.Ad"
                                               style="display:none;"
                                               @(Model.LedDesteklenenRenkler.Contains(renk.Ad) ? "checked" : "") />
                                        <span style="width:14px; height:14px; border-radius:50%;
                                     background:@renk.Kod; border:1px solid #ddd;
                                     display:inline-block; flex-shrink:0;"></span>
                                        @renk.Ad
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                        <a href="/DigitalLabelSpec/Index" class="btn btn-light px-4" style="border-radius:10px;">
                            İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Renk seçici tıklama efekti
        document.querySelectorAll('.renk-secici').forEach(function (label) {
            var checkbox = label.querySelector('input[type=checkbox]');

            function guncelle() {
                if (checkbox.checked) {
                    label.style.background = '#eff6ff';
                    label.style.borderColor = '#2563eb';
                    label.style.color = '#2563eb';
                } else {
                    label.style.background = 'white';
                    label.style.borderColor = '#e0e0e0';
                    label.style.color = 'inherit';
                }
            }

            guncelle(); // Sayfa açılınca mevcut durumu uygula
            checkbox.addEventListener('change', guncelle);
        });
    </script>
}