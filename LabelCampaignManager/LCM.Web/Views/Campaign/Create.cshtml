@model LCM.Web.ViewModels.CampaignCreateViewModel
@{
    ViewData["Title"] = "Yeni Kampanya";
}

<div class="row g-4">
    <!-- SOL: Form -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-1">Yeni Kampanya</h5>
                <p class="text-muted mb-4" style="font-size:0.88rem;">
                    Şablon seç, alanları doldur, önizlemeyi kontrol et
                </p>

                <form asp-action="Create" method="post" id="kampanyaForm">
                    <input type="hidden" id="secilenSablonId" name="_secilenSablon" value="@Model.SablonId" />
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" style="font-size:0.88rem;"></div>

                    <!-- Şablon Seçimi -->
                    <div class="mb-3">
                        <label class="form-label fw-500" style="font-size:0.88rem;">Şablon</label>
                        <select asp-for="SablonId" asp-items="ViewBag.Sablonlar"
                                class="form-select" style="border-radius:10px;"
                                id="sablonSelect" onchange="sablonSecildi(this.value)">
                            <option value="">— Şablon Seçin —</option>
                        </select>
                        <span asp-validation-for="SablonId" class="text-danger" style="font-size:0.82rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-500" style="font-size:0.88rem;">
                            Şube <span class="text-danger">*</span>
                        </label>
                        <div class="border rounded p-2" style="border-radius:10px !important; max-height:160px; overflow-y:auto;">
                            @foreach (var store in (List<LCM.Domain.Entities.Store>)ViewBag.Stores)
                            {
                                <div class="form-check">
                                    <input class="form-check-input store-check" type="checkbox"
                                           name="StoreIds" value="@store.Id" id="store_@store.Id" />
                                    <label class="form-check-label" for="store_@store.Id" style="font-size:0.88rem;">
                                        @store.StoreCode - @store.StoreName
                                    </label>
                                </div>
                            }
                        </div>
                        <span class="text-danger small" id="storeHata" style="display:none;">En az bir şube seçiniz.</span>
                    </div>

                    <!-- Dinamik Alanlar -->
                    <div id="dinamikAlanlar">
                        <div class="text-center text-muted py-3" style="font-size:0.88rem;">
                            <i class="bi bi-arrow-up-circle me-1"></i>Önce şablon seçin
                        </div>
                    </div>

                    <!-- Tarih ve Durum -->
                    <div id="tarihAlanlari" style="display:none;">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-500" style="font-size:0.88rem;">Başlangıç Tarihi</label>
                                <input asp-for="BaslangicTarihi" type="date" class="form-control"
                                       style="border-radius:10px;" onchange="tarihGuncelle()"  />
                                <span asp-validation-for="BaslangicTarihi" class="text-danger" style="font-size:0.82rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-500" style="font-size:0.88rem;">Bitiş Tarihi</label>
                                <input asp-for="BitisTarihi" type="date" class="form-control"
                                       style="border-radius:10px;" onchange="tarihGuncelle()"/>
                                <span asp-validation-for="BitisTarihi" class="text-danger" style="font-size:0.82rem;"></span>
                            </div>
                        </div>
                        <div class="mb-3" id="dateRangeWrapper" style="display:none;">
                            <label class="form-label fw-500" style="font-size:0.88rem;">Tarih Aralığı Metni</label>
                            <input type="text" name="DateRange" id="alan_DateRange" class="form-control"
                                   style="border-radius:10px;" />
                            <div class="text-muted mt-1" style="font-size:0.78rem;">
                                <i class="bi bi-info-circle me-1"></i>Tarihler seçilince otomatik dolar, istersen düzenleyebilirsin.
                            </div>
                        </div>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-500" style="font-size:0.88rem;">Durum</label>
                                <select asp-for="Durum" class="form-select" style="border-radius:10px;">
                                    <option value="Aktif">Aktif</option>
                                    <option value="Pasif">Pasif</option>
                                    <option value="Planlanmış">Planlanmış</option>
                                    <option value="Taslak">Taslak</option>
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="Durum" value="Taslak" />
                        }
                        @if (ViewBag.CaptchaAktif == true)
                        {
                            <div class="mb-3 p-3" style="background:#fffbeb; border-radius:10px; border:1px solid #fde68a;">
                                <label class="form-label fw-500" style="font-size:0.88rem;">
                                    <i class="bi bi-shield-check me-1 text-warning"></i>
                                    Güvenlik Sorusu: <strong>@ViewBag.CaptchaSoru</strong>
                                </label>
                                <input type="number" name="CaptchaCevap" class="form-control"
                                       placeholder="Cevabınız" style="border-radius:10px; max-width:150px;" />
                                <span class="text-danger" style="font-size:0.82rem;">
                                    @Html.ValidationMessage("CaptchaCevap")
                                </span>
                            </div>
                        }
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;">
                                <i class="bi bi-check-lg me-1"></i>Kaydet
                            </button>
                            <a href="/Campaign/Index" class="btn btn-light px-4" style="border-radius:10px;">
                                İptal
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SAĞ: Canlı Önizleme -->
<!-- SAĞ: Canlı Önizleme -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-eye me-2 text-primary"></i>Canlı Önizleme
                </h6>
                <div id="onizlemeAlani">
                    <div class="text-center text-muted py-5" style="font-size:0.88rem;">
                        <i class="bi bi-layout-text-window display-5 d-block mb-2 opacity-25"></i>
                        Yükleniyor...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
              var alanEtiketleri = {
            'Baslik': 'Başlık', 'AltBaslik': 'Alt Başlık', 'KampanyaNotu': 'Kampanya Notu',
            'Subheadline': 'Ürün Alt Satır', 'OriginalPrice': 'Eski Fiyat (₺)', 'DiscountedPrice': 'Yeni Fiyat (₺)',
            'BuyQuantityText': 'Alım Adedi Metni', 'PayQuantityText': 'Ödeme Adedi Metni', 'DateRange': 'Tarih Aralığı',
            'Headline': 'Ürün Ana Satır', 'MinBasketText': 'Sepet Koşulu', 'DetailText': 'Ürün Detay Satırı',
            'CampaignDescription': 'Kampanya Açıklaması', 'IsLocalProduction': 'Yerli Üretim',
            'OriginCountry': 'Üretim Yeri', 'UnitPrice': 'Birim Fiyatı', 'PriceUpdateDate': 'Fiyat Değişiklik Tarihi'
        };

        var fiyatAlanlari = [];

        var aylar = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];

        function sablonSecildi(sablonId) {
            if (!sablonId) {
                document.getElementById('dinamikAlanlar').innerHTML =
                    '<div class="text-center text-muted py-3" style="font-size:0.88rem;"><i class="bi bi-arrow-up-circle me-1"></i>Önce şablon seçin</div>';
                document.getElementById('tarihAlanlari').style.display = 'none';
                document.getElementById('onizlemeAlani').innerHTML =
                    '<div class="text-center text-muted py-5" style="font-size:0.88rem;"><i class="bi bi-layout-text-window display-5 d-block mb-2 opacity-25"></i>Şablon seçilince önizleme burada görünür</div>';
                return;
            }
            fetch('/Campaign/GetTemplateFields?templateId=' + sablonId)
                .then(r => r.json())
                .then(data => {
                            alanlariBuild(data.alanlar, data.etiketler || {});
                    onizlemeBuild(data);
                    document.getElementById('tarihAlanlari').style.display = 'block';
                    tarihGuncelle();
                });
        }

        function alanlariBuild(alanlar, layoutEtiketleri) {
            var html = '';
            alanlar.forEach(function (alan) {
                if (alan === 'DateRange') return;
                if (alan === 'IsLocalProduction') {
                    html += `
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" name="IsLocalProduction" id="alan_IsLocalProduction"
                                       class="form-check-input" value="true" onchange="onizlemeGuncelle()" />
                                <label class="form-check-label" style="font-size:0.88rem;">Yerli Üretim</label>
                            </div>
                            <input type="hidden" name="IsLocalProduction" value="false" />
                        </div>`;
                    return;
                }
                        var etiket = (layoutEtiketleri && layoutEtiketleri[alan]) || alanEtiketleri[alan] || alan;
                var tip = fiyatAlanlari.includes(alan) ? 'number' : 'text';
                var inputName = alan.charAt(0).toUpperCase() + alan.slice(1);
                html += `
                    <div class="mb-3">
                        <label class="form-label fw-500" style="font-size:0.88rem;">${etiket}</label>
                        <input type="${tip}" name="${inputName}" id="alan_${alan}"
                               class="form-control" style="border-radius:10px;"
                               oninput="onizlemeGuncelle()" />
                    </div>`;
            });
            document.getElementById('dinamikAlanlar').innerHTML = html;
        }

                function onizlemeBuild(data) {
            if (!data.layoutJson) {
                document.getElementById('onizlemeAlani').innerHTML =
                    '<div class="text-center text-muted py-5"><i class="bi bi-exclamation-circle display-5 d-block mb-2"></i>Bu layoutun tasarımı henüz çizilmemiş.</div>';
                return;
            }
            var layoutJson = JSON.parse(data.layoutJson);
            onizlemeBuildFromJson(layoutJson);
        }

        function onizlemeBuildFromJson(layoutJson) {
            var w  = layoutJson.genislik  || 300;
            var h  = layoutJson.yukseklik || 400;
            var bg = layoutJson.arkaplan  || '#fff';

            var inner = `<div style="width:${w}px; height:${h}px; background:${bg};
                border:2px solid #e0e0e0; border-radius:8px; position:relative;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
                margin:0 auto; overflow:hidden;">`;

            (layoutJson.alanlar || []).forEach(function(alan) {
                var justify = alan.textAlign==='center'?'center':(alan.textAlign==='right'?'flex-end':'flex-start');

                if (alan.ad === 'IsLocalProduction') {
                    inner += `<div id="prev_${alan.ad}"
                        style="position:absolute; left:${alan.x}px; top:${alan.y}px;
                        width:${alan.width}px; height:${alan.height}px;
                        display:none; align-items:center; justify-content:${justify};
                        overflow:hidden; box-sizing:border-box;">
                        <img src="/img/yerliuretimkirmizi.svg" style="width:100%; height:100%; object-fit:contain;" />
                    </div>`;
                } else {
                           var efektSvg = '';
        var ef = alan.efektler || {};
        if (Object.values(ef).some(function(v){ return v===true; })) {
            var renk = ef.renk || '#e63946';
            var ek = ef.kalinlik || 2;
            var pw = alan.width, ph = alan.height;
            var cw = (ef.uzunluk && ef.uzunluk > 0) ? ef.uzunluk : pw;
            var ch = (ef.yukseklik && ef.yukseklik > 0) ? ef.yukseklik : ph;
            var ox = (pw - cw) / 2;
            var oy = (ph - ch) / 2;
            var lines = '';
            if (ef.ust)      lines += '<line x1="0" y1="1" x2="' + pw + '" y2="1" stroke="' + renk + '" stroke-width="' + ek + '"/>';
            if (ef.alt)      lines += '<line x1="0" y1="' + (ph-1) + '" x2="' + pw + '" y2="' + (ph-1) + '" stroke="' + renk + '" stroke-width="' + ek + '"/>';
            if (ef.sol)      lines += '<line x1="1" y1="0" x2="1" y2="' + ph + '" stroke="' + renk + '" stroke-width="' + ek + '"/>';
            if (ef.sag)      lines += '<line x1="' + (pw-1) + '" y1="0" x2="' + (pw-1) + '" y2="' + ph + '" stroke="' + renk + '" stroke-width="' + ek + '"/>';
            if (ef.carpraz1) lines += '<line x1="' + ox + '" y1="' + oy + '" x2="' + (ox+cw) + '" y2="' + (oy+ch) + '" stroke="' + renk + '" stroke-width="' + ek + '"/>';
            if (ef.carpraz2) lines += '<line x1="' + (ox+cw) + '" y1="' + oy + '" x2="' + ox + '" y2="' + (oy+ch) + '" stroke="' + renk + '" stroke-width="' + ek + '"/>';
            efektSvg = '<svg style="position:absolute;top:0;left:0;pointer-events:none;" width="' + pw + '" height="' + ph + '">' + lines + '</svg>';
        }

                         var fontFamilyStyle = alan.fontAilesi ? alan.fontAilesi : 'inherit';
                            inner += `<div id="prev_${alan.ad}"
                                style="position:absolute; left:${alan.x}px; top:${alan.y}px;
                                width:${alan.width}px; height:${alan.height}px;
                                font-size:${alan.fontSize}px; font-weight:${alan.fontWeight};
                                color:${alan.color}; text-align:${alan.textAlign};
                                font-family:${fontFamilyStyle};
                                display:none; align-items:center; justify-content:${justify};
                                overflow:hidden; box-sizing:border-box;">
                                ${efektSvg}
                                <span class="prev-metin" style="position:relative; z-index:1;"></span>
                            </div>`;
                }
            });

            (layoutJson.cizgiler || []).forEach(function(c) {
                var svgIc = '';
                if (c.yon==='yatay')         svgIc = `<line x1="0" y1="${c.height/2}" x2="${c.width}" y2="${c.height/2}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;
                else if (c.yon==='dikey')    svgIc = `<line x1="${c.width/2}" y1="0" x2="${c.width/2}" y2="${c.height}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;
                else if (c.yon==='carpraz1') svgIc = `<line x1="0" y1="0" x2="${c.width}" y2="${c.height}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;
                else if (c.yon==='carpraz2') svgIc = `<line x1="${c.width}" y1="0" x2="0" y2="${c.height}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;

                inner += `<div style="position:absolute; left:${c.x}px; top:${c.y}px;
                    width:${c.width}px; height:${c.height}px; pointer-events:none;">
                    <svg width="${c.width}" height="${c.height}">${svgIc}</svg>
                </div>`;
            });

            inner += '</div>';
            document.getElementById('onizlemeAlani').innerHTML = inner;
        }

       


               function onizlemeGuncelle() {
            var alanlar = ['Baslik','AltBaslik','KampanyaNotu','Subheadline',
                           'OriginalPrice','DiscountedPrice','BuyQuantityText','PayQuantityText',
                           'Headline','MinBasketText','DetailText','CampaignDescription',
                           'OriginCountry','UnitPrice','PriceUpdateDate','DateRange'];

            alanlar.forEach(function(alan) {
                var input = document.getElementById('alan_' + alan);
                var prev  = document.getElementById('prev_' + alan);
                if (!input || !prev) return;
                var deger = input.value.trim();
                        var metin = prev.querySelector('.prev-metin') || prev;
        if (deger) {
            if (alan === 'OriginalPrice' || alan === 'DiscountedPrice') {
                metin.textContent = '₺' + deger;
            } else {
                metin.textContent = deger;
            }
            prev.style.display = 'flex';
        } else {
            prev.style.display = 'none';
        }
            });

            // IsLocalProduction
            var localPrev  = document.getElementById('prev_IsLocalProduction');
            var localInput = document.getElementById('alan_IsLocalProduction');
            if (localPrev && localInput) {
                localPrev.style.display = localInput.checked ? 'flex' : 'none';
            }

            
        }

//         function tarihGuncelle() {
//     var bas = document.querySelector('[name="BaslangicTarihi"]').value;
//     var bit = document.querySelector('[name="BitisTarihi"]').value;
//     var dateRangeInput = document.getElementById('alan_DateRange');
//     var wrapper = document.getElementById('dateRangeWrapper');
//     if (!bas || !bit) return;

//     var b = new Date(bas);
//     var e = new Date(bit);
//     var metin = '';
//     if (b.getMonth() === e.getMonth() && b.getFullYear() === e.getFullYear()) {
//         metin = b.getDate() + ' - ' + e.getDate() + ' ' + aylar[e.getMonth()] + ' ' + e.getFullYear();
//     } else {
//         metin = b.getDate() + ' ' + aylar[b.getMonth()] + ' - ' + e.getDate() + ' ' + aylar[e.getMonth()] + ' ' + e.getFullYear();
//     }

//     if (dateRangeInput) {
//         dateRangeInput.value = metin;
//         if (wrapper) wrapper.style.display = 'block';
//     }

//     onizlemeGuncelle();
// }
        function tarihGuncelle() {
            var basInput = document.querySelector('[name="BaslangicTarihi"]');
            var bitInput = document.querySelector('[name="BitisTarihi"]');
            var bas = basInput.value;
            var bit = bitInput.value;
            var dateRangeInput = document.getElementById('alan_DateRange');
            var wrapper = document.getElementById('dateRangeWrapper');

            // Başlangıç seçilince bitiş minimum'u ayarla
            if (bas) {
                bitInput.min = bas;
                // Eğer bitiş başlangıçtan küçükse sıfırla
                if (bit && bit < bas) {
                    bitInput.value = '';
                    bit = '';
                }
            }

            // Bitiş seçilince başlangıç maksimum'u ayarla
            if (bit) {
                basInput.max = bit;
                if (bas && bas > bit) {
                    basInput.value = '';
                    bas = '';
                }
            }

            if (!bas || !bit) {
                if (dateRangeInput) dateRangeInput.value = '';
                onizlemeGuncelle();
                return;
            }

            var b = new Date(bas);
            var e = new Date(bit);
            var metin = '';
            if (b.getMonth() === e.getMonth() && b.getFullYear() === e.getFullYear()) {
                metin = b.getDate() + ' - ' + e.getDate() + ' ' + aylar[e.getMonth()] + ' ' + e.getFullYear();
            } else {
                metin = b.getDate() + ' ' + aylar[b.getMonth()] + ' - ' + e.getDate() + ' ' + aylar[e.getMonth()] + ' ' + e.getFullYear();
            }

            if (dateRangeInput) {
                dateRangeInput.value = metin;
                if (wrapper) wrapper.style.display = 'block';
            }
            onizlemeGuncelle();
        }
        window.addEventListener('load', function () {
            var sablonId = '@Model.SablonId';
            if (sablonId && sablonId !== '0') {
                document.getElementById('sablonSelect').value = sablonId;
                sablonSecildi(sablonId);
            }
        });

        document.getElementById('kampanyaForm').addEventListener('submit', function() {
            var fiyatlar = ['OriginalPrice', 'DiscountedPrice'];
            fiyatlar.forEach(function(alan) {
                var input = document.getElementById('alan_' + alan);
                if (input) input.value = input.value.replace(',', '.');
            });
        });
                       document.getElementById('kampanyaForm').addEventListener('submit', function(e) {
            var secili = document.querySelectorAll('.store-check:checked').length;
            if (secili === 0) {
                e.preventDefault();
                e.stopImmediatePropagation();
                document.getElementById('storeHata').style.display = 'block';
                return;
            }
            document.getElementById('storeHata').style.display = 'none';
        }, true);
    </script>
}