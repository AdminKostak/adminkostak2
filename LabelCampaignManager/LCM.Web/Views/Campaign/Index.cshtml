@model List<LCM.Web.ViewModels.CampaignListViewModel>
@{
    ViewData["Title"] = "Kampanyalar";
    // Aktif filtre var mı? (filtre panelini açık tutmak için)
    bool filtreAktif = ViewBag.FiltreDurum != null
                    || ViewBag.FiltreEkleyenId != null
                    || ViewBag.FiltreBaslangicTarihi != null
                    || !string.IsNullOrEmpty(ViewBag.FiltreAramaMetni as string);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-0">Kampanyalar</h5>
        <small class="text-muted">Tüm kampanyaları görüntüle ve yönet</small>
    </div>
    <div class="d-flex gap-2">
        @* Filtre aç/kapat butonu *@
        <button class="btn btn-outline-secondary btn-sm px-3"
                type="button"
                id="btnFiltreToggle"
                title="Filtreleri Göster/Gizle">
            <i class="bi bi-funnel me-1"></i>Filtre
            @if (filtreAktif)
            {
                <span class="badge bg-primary ms-1" style="font-size:0.65rem;">●</span>
            }
        </button>
        <a href="/Campaign/PrintList" target="_blank"
           class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-printer me-1"></i>Yazdır
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("KampanyaYonetici") || User.IsInRole("VeriGirisi"))
        {
            <a href="/Campaign/Create" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-plus-lg me-1"></i>Yeni Kampanya
            </a>
        }
    </div>
</div>

@* Filtre Paneli *@
<div id="filtrePaneli"
     class="card border-0 shadow-sm mb-3"
     style="border-radius:12px; @(filtreAktif ? "" : "display:none;")">
    <div class="card-body p-3">
        <form method="get" action="/Campaign/Index" id="filtreForm">
            <div class="row g-2 align-items-end">

                @* Arama (SKU / Başlık) *@
                <div class="col-md-3">
                    <label class="form-label mb-1" style="font-size:0.78rem; color:#666;">
                        <i class="bi bi-search me-1"></i>SKU / Başlık
                    </label>
                    <input type="text"
                           name="aramaMetni"
                           class="form-control form-control-sm"
                           style="border-radius:8px;"
                           placeholder="Ara..."
                           value="@ViewBag.FiltreAramaMetni" />
                </div>

                @* Durum *@
                <div class="col-md-2">
                    <label class="form-label mb-1" style="font-size:0.78rem; color:#666;">
                        <i class="bi bi-circle-half me-1"></i>Durum
                    </label>
                    <select name="durum" class="form-select form-select-sm" style="border-radius:8px;">
                        <option value="">Tümü</option>
                        @foreach (var d in new[] { "Aktif", "Pasif", "Taslak", "Planlanmış",
                            "Onay Bekliyor", "Onaylandı", "Reddedildi", "Revize İstendi" })
                        {
                            string filtreDurum = ViewBag.FiltreDurum as string ?? "";
                            if (filtreDurum == d)
                            {
                                <option value="@d" selected="selected">@d</option>
                            }
                            else
                            {
                                <option value="@d">@d</option>
                            }
                        }
                    </select>
                </div>

                @* Oluşturan Kullanıcı *@
                <div class="col-md-3">
                    <label class="form-label mb-1" style="font-size:0.78rem; color:#666;">
                        <i class="bi bi-person me-1"></i>Oluşturan
                    </label>
                    <select name="ekleyenId" class="form-select form-select-sm" style="border-radius:8px;">
                        <option value="">Tümü</option>
                        @if (ViewBag.Kullanicilar != null)
                        {
                            foreach (var k in (IEnumerable<dynamic>)ViewBag.Kullanicilar)
                            {
                                int kId = (int)k.Id;
                                int? filtreId = ViewBag.FiltreEkleyenId as int?;
                                if (filtreId.HasValue && filtreId.Value == kId)
                                {
                                    <option value="@k.Id" selected="selected">@k.AdSoyad</option>
                                }
                                else
                                {
                                    <option value="@k.Id">@k.AdSoyad</option>
                                }
                            }
                        }
                    </select>
                </div>

                @* Başlangıç Tarihi *@
                <div class="col-md-2">
                    <label class="form-label mb-1" style="font-size:0.78rem; color:#666;">
                        <i class="bi bi-calendar me-1"></i>Başlangıç Tarihi
                    </label>
                    <input type="date"
                           name="baslangicTarihi"
                           class="form-control form-control-sm"
                           style="border-radius:8px;"
                           value="@ViewBag.FiltreBaslangicTarihi" />
                </div>

                @* Butonlar *@
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill" style="border-radius:8px;">
                        <i class="bi bi-search me-1"></i>Filtrele
                    </button>
                    <a href="/Campaign/Index" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;" title="Temizle">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>

            </div>
        </form>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm" style="border-radius:14px;">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" style="border-radius:14px; overflow:hidden;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">SKU / BARKOD</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">ŞABLON</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">TARİH ARALIĞI</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">OLUŞTURMA</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">ŞUBE</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">DURUM</th>
                    <th class="px-4 py-3 text-muted text-end" style="font-size:0.82rem;">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @* SKU + Barkod *@
                        <td class="px-4 py-3">
                            <div style="font-size:0.9rem; font-weight:700; color:#111;">@item.Sku</div>
                            <div style="font-size:0.75rem; color:#888; font-family:monospace;">@item.Barkod</div>
                        </td>

                        @* Şablon *@
                        <td class="px-4 py-3">
                            <span class="badge rounded-pill px-2 py-1"
                                  style="background:#eff6ff; color:#2563eb; font-size:0.78rem;">
                                @item.SablonAdi
                            </span>
                        </td>

                        @* Tarih Aralığı *@
                        <td class="px-4 py-3" style="font-size:0.82rem; color:#555;">
                            <div><i class="bi bi-calendar-check me-1 text-success"></i>@item.BaslangicTarihi.ToString("dd.MM.yyyy")</div>
                            <div class="mt-1"><i class="bi bi-calendar-x me-1 text-danger"></i>@item.BitisTarihi.ToString("dd.MM.yyyy")</div>
                        </td>

                        @* Oluşturma Tarihi *@
                        <td class="px-4 py-3">
                            <div style="font-size:0.82rem; color:#555;">@item.OlusturmaTarihi.ToString("dd.MM.yyyy")</div>
                            <div style="font-size:0.75rem; color:#aaa;">@item.OlusturmaTarihi.ToString("HH:mm")</div>
                            @* Oluşturan kullanıcı *@
                            <div style="font-size:0.72rem; color:#94a3b8; margin-top:2px;">
                                <i class="bi bi-person me-1"></i>@item.EkleyenAdi
                            </div>
                        </td>

                        @* Şubeler *@
                        <td class="px-4 py-3">
                            @if (!string.IsNullOrEmpty(item.StoreDisplay))
                            {
                                foreach (var s in item.StoreDisplay.Split(", "))
                                {
                                    <span class="badge rounded-pill px-2 py-1 me-1 mb-1"
                                          style="background:#f0fdf4; color:#16a34a; font-size:0.75rem;">
                                        @s.Split(" - ")[0]
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:0.78rem;">—</span>
                            }
                        </td>

                        @* Durum + Son Onay Aksiyonu *@
                        <td class="px-4 py-3">
                            @{
                                // Ana durum badge'i
                                var (durumBg, durumRenk, durumIkon, durumEtiket) = item.Durum switch
                                {
                                    "Aktif"         => ("#f0fdf4", "#16a34a", "bi-check-circle",    "Aktif"),
                                    "Pasif"         => ("#fef2f2", "#dc2626", "bi-x-circle",        "Pasif"),
                                    "Planlanmış"    => ("#f0f4ff", "#6366f1", "bi-clock",           "Planlanmış"),
                                    "Onay Bekliyor" => ("#fffbeb", "#d97706", "bi-hourglass-split", "Onay Bekliyor"),
                                    "Onaylandı"     => ("#f0fdf4", "#16a34a", "bi-check2-all",      "Onaylandı"),
                                    "Reddedildi"    => ("#fef2f2", "#dc2626", "bi-x-circle-fill",   "Reddedildi"),
                                    "Revize İstendi"=> ("#fffbeb", "#d97706", "bi-pencil-square",   "Revize İstendi"),
                                    _               => ("#f8fafc", "#64748b", "bi-pencil-square",   "Taslak")
                                };
                            }
                            <span class="badge rounded-pill px-2 py-1 d-block mb-1"
                                  style="background:@durumBg; color:@durumRenk; font-size:0.78rem;">
                                <i class="bi @durumIkon me-1"></i>@durumEtiket
                            </span>

                            @* Son onay aksiyonu (varsa, durum'dan farklıysa göster) *@
                            @if (!string.IsNullOrEmpty(item.SonOnayAksiyonu) && item.SonOnayAksiyonu != item.Durum)
                            {
                                var (onayBg, onayRenk, onayIkon) = item.SonOnayAksiyonu switch
                                {
                                    "Onaylandı"      => ("#f0fdf4", "#16a34a", "bi-check2-all"),
                                    "Reddedildi"     => ("#fef2f2", "#dc2626", "bi-x-circle-fill"),
                                    "Revize İstendi" => ("#fffbeb", "#d97706", "bi-pencil-square"),
                                    "Onaya Gönderildi"=>("#eff6ff", "#2563eb", "bi-send"),
                                    _                => ("#f8fafc", "#64748b", "bi-info-circle")
                                };
                                <span class="badge rounded-pill px-2 py-1 d-block"
                                      style="background:@onayBg; color:@onayRenk; font-size:0.72rem;"
                                      title="@item.SonOnayYorumu">
                                    <i class="bi @onayIkon me-1"></i>@item.SonOnayAksiyonu
                                </span>
                            }
                        </td>

                        @* İşlemler *@
                        <td class="px-4 py-3 text-end">
                            @* Detay *@
                            <a href="/Campaign/Detail/@item.Id"
                               class="btn btn-sm btn-outline-secondary me-1"
                               style="border-radius:8px;"
                               title="Detay">
                                <i class="bi bi-eye"></i>
                            </a>

                            @* ⚡ Hızlı Önizleme — hover ile popup açar *@
                            <button type="button"
                                    class="btn btn-sm btn-outline-info me-1 btn-hizli-onizle"
                                    style="border-radius:8px;"
                                    data-id="@item.Id"
                                    data-sku="@item.Sku"
                                    title="Hızlı Önizle">
                                <i class="bi bi-lightning-charge"></i>
                            </button>

                            @if (User.IsInRole("Admin") || User.IsInRole("VeriGirisi"))
                            {
                                <a href="/Campaign/Edit/@item.Id"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   style="border-radius:8px;"
                                   title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("KampanyaYonetici"))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning me-1 btn-json-onizle"
                                        style="border-radius:8px;"
                                        data-id="@item.Id"
                                        data-sku="@item.Sku"
                                        title="JSON Önizle">
                                    <i class="bi bi-braces"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-success me-1 btn-esl-gonder"
                                        style="border-radius:8px;"
                                        data-id="@item.Id"
                                        data-sku="@item.Sku"
                                        title="ESL Gönder">
                                    <i class="bi bi-send"></i>
                                </button>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <form method="post" action="/Campaign/Delete/@item.Id"
                                      style="display:inline;" data-noloading="true">
                                    @Html.AntiForgeryToken()
                                    <button type="button"
                                            onclick="openConfirm(this.closest('form'))"
                                            class="btn btn-sm btn-outline-danger"
                                            style="border-radius:8px;"
                                            title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-megaphone display-6 d-block mb-2"></i>
                            @if (filtreAktif)
                            {
                                <span>Filtreye uyan kampanya bulunamadı.</span>
                                <br />
                                <a href="/Campaign/Index" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-x me-1"></i>Filtreyi Temizle
                                </a>
                            }
                            else
                            {
                                <span>Henüz kampanya eklenmemiş.</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ─── Hızlı Önizleme Popup ─────────────────────────────────────────── *@
@* Mouse ile butona gelindiğinde ekranın ortasında çıkar, ayrılınca kapanır *@
<div id="hizliOnizlePopup"
     style="display:none; position:fixed; z-index:9990;
            top:50%; left:50%; transform:translate(-50%,-50%);
            background:white; border-radius:16px;
            box-shadow:0 20px 60px rgba(0,0,0,0.18);
            padding:20px; min-width:340px; pointer-events:none;">
    @* Başlık *@
    <div style="font-size:0.72rem; color:#888; letter-spacing:0.05em;
                text-transform:uppercase; margin-bottom:10px;">
        <i class="bi bi-lightning-charge-fill text-warning me-1"></i>
        Hızlı Önizleme — SKU: <span id="popupSku" style="font-weight:700;"></span>
    </div>
    @* Önizleme alanı *@
    <div id="popupOnizlemeAlani"
         style="display:flex; align-items:center; justify-content:center; min-height:200px;">
        <div class="spinner-border spinner-border-sm text-secondary"></div>
    </div>
</div>

@* Popup arka plan overlay (yarı saydam) *@
<div id="hizliOnizleOverlay"
     style="display:none; position:fixed; z-index:9989;
            top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.15); pointer-events:none;">
</div>

@* JSON Önizleme + Gönderim Modal (mevcut kod korundu) *@
<div class="modal fade" id="jsonModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-braces me-2 text-warning"></i>ESL JSON Önizleme
                    </h6>
                    <small class="text-muted">SKU: <span id="jsonModalSku"></span></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pb-0">
                <div id="jsonModalLoading" class="text-center py-5">
                    <div class="spinner-border text-warning" role="status"></div>
                    <div class="mt-2 text-muted small">JSON oluşturuluyor...</div>
                </div>
                <div id="jsonModalHata" class="alert alert-danger" style="display:none;"></div>
                <div id="jsonModalContent" style="display:none;">
                    <ul class="nav nav-tabs" id="subeTabs" role="tablist"></ul>
                    <div class="tab-content border border-top-0 rounded-bottom p-0"
                         id="subeTabContent"
                         style="background:#1e1e1e; border-radius:0 0 10px 10px!important;"></div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-3">
                <div id="gonderimDurum" class="me-auto" style="display:none; font-size:0.82rem;"></div>
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal" style="border-radius:8px;">
                    <i class="bi bi-x me-1"></i>Kapat
                </button>
                <button type="button" id="btnOnaylaGonder"
                        class="btn btn-sm btn-success"
                        style="border-radius:8px; display:none;">
                    <i class="bi bi-send me-1"></i>Onayla ve Gönder
                </button>
            </div>
        </div>
    </div>
</div>

@* Toast bildirimleri *@
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
    <div id="toastBasari" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastBasariMesaj"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    <div id="toastHata" class="toast align-items-center text-white bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastHataMesaj"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // CSRF token (form dışı POST'lar için)
    const antiForgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
    let aktifKampanyaId = null;

    // ── Filtre paneli aç/kapat ───────────────────────────────────────────
    document.getElementById('btnFiltreToggle').addEventListener('click', function () {
        const panel = document.getElementById('filtrePaneli');
        const gorunur = panel.style.display !== 'none';
        panel.style.display = gorunur ? 'none' : 'block';
    });

    // ── Toast yardımcı fonksiyonu ────────────────────────────────────────
    function toastGoster(mesaj, basarili) {
        if (basarili) {
            document.getElementById('toastBasariMesaj').textContent = mesaj;
            bootstrap.Toast.getOrCreateInstance(
                document.getElementById('toastBasari'), { delay: 5000 }).show();
        } else {
            document.getElementById('toastHataMesaj').textContent = mesaj;
            bootstrap.Toast.getOrCreateInstance(
                document.getElementById('toastHata'), { delay: 7000 }).show();
        }
    }

    // ── Hızlı Önizleme (⚡ hover popup) ─────────────────────────────────
    // Önizleme için Detail sayfasındaki build fonksiyonları kullanılır
    let onizlemeCache = {};       // id → { layoutJson, degerler } önbelleği
    let aktifPopupId  = null;
    let hideTimeout   = null;

    // Layout JSON'dan önizleme HTML'i oluştur (Detail.cshtml'deki mantıkla aynı)
    function popupOnizlemeBuild(layoutJson, degerler, hedefEl) {
        if (!layoutJson) {
            hedefEl.innerHTML = '<div class="text-muted text-center py-3" style="font-size:0.82rem;">Layout tanımlanmamış.</div>';
            return;
        }
        const layout = JSON.parse(layoutJson);
        const w = layout.genislik  || 300;
        const h = layout.yukseklik || 400;
        const bg = layout.arkaplan || '#fff';

        let inner = `<div style="width:${w}px; height:${h}px; background:${bg};
            border:2px solid #e0e0e0; border-radius:8px; position:relative;
            font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            margin:0 auto; overflow:hidden; transform-origin:top center;
            transform:scale(${Math.min(1, 300/w)});">`;  /* küçük ekrana sığdır */

        (layout.alanlar || []).forEach(alan => {
            const justify = alan.textAlign === 'center' ? 'center'
                          : alan.textAlign === 'right'  ? 'flex-end' : 'flex-start';
            const deger   = degerler[alan.ad];

            if (alan.ad === 'IsLocalProduction') {
                if (deger === true || deger === 'True') {
                    inner += `<div style="position:absolute; left:${alan.x}px; top:${alan.y}px;
                        width:${alan.width}px; height:${alan.height}px;
                        display:flex; align-items:center; justify-content:${justify}; overflow:hidden;">
                        <img src="/img/yerliuretimkirmizi.svg"
                             style="width:100%; height:100%; object-fit:contain;" /></div>`;
                }
                return;
            }

            if (!deger) return;  // değeri olmayan alanı gösterme

            const fontFamily = alan.fontAilesi || 'inherit';
            const metin = (alan.ad === 'OriginalPrice' || alan.ad === 'DiscountedPrice')
                        ? '₺' + deger : deger;

            inner += `<div style="position:absolute; left:${alan.x}px; top:${alan.y}px;
                width:${alan.width}px; height:${alan.height}px;
                font-size:${alan.fontSize}px; font-weight:${alan.fontWeight};
                color:${alan.color}; text-align:${alan.textAlign};
                font-family:${fontFamily};
                display:flex; align-items:center; justify-content:${justify};
                overflow:hidden; box-sizing:border-box;">
                <span style="position:relative; z-index:1;">${metin}</span></div>`;
        });

        // Çizgiler
        (layout.cizgiler || []).forEach(c => {
            let svgIc = '';
            if      (c.yon === 'yatay')   svgIc = `<line x1="0" y1="${c.height/2}" x2="${c.width}" y2="${c.height/2}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;
            else if (c.yon === 'dikey')   svgIc = `<line x1="${c.width/2}" y1="0" x2="${c.width/2}" y2="${c.height}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;
            else if (c.yon === 'carpraz1')svgIc = `<line x1="0" y1="0" x2="${c.width}" y2="${c.height}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;
            else if (c.yon === 'carpraz2')svgIc = `<line x1="${c.width}" y1="0" x2="0" y2="${c.height}" stroke="${c.renk}" stroke-width="${c.kalinlik}"/>`;
            inner += `<div style="position:absolute; left:${c.x}px; top:${c.y}px;
                width:${c.width}px; height:${c.height}px; pointer-events:none;">
                <svg width="${c.width}" height="${c.height}">${svgIc}</svg></div>`;
        });

        inner += '</div>';
        hedefEl.innerHTML = inner;
    }

    // Popup'ı göster
    function popupGoster(id, sku) {
        clearTimeout(hideTimeout);
        aktifPopupId = id;

        const popup   = document.getElementById('hizliOnizlePopup');
        const overlay = document.getElementById('hizliOnizleOverlay');
        const skuEl   = document.getElementById('popupSku');
        const alan    = document.getElementById('popupOnizlemeAlani');

        skuEl.textContent = sku;
        popup.style.display   = 'block';
        overlay.style.display = 'block';

        // Cache'de varsa tekrar fetch yapma
        if (onizlemeCache[id]) {
            popupOnizlemeBuild(onizlemeCache[id].layoutJson, onizlemeCache[id].degerler, alan);
            return;
        }

        // Yükleniyor spinner
        alan.innerHTML = '<div class="spinner-border spinner-border-sm text-secondary"></div>';

        fetch(`/Campaign/HizliOnizle?id=${id}`)
            .then(r => r.json())
            .then(data => {
                if (!data.success || aktifPopupId !== id) return; // kullanıcı başka butona geçtiyse iptal
                onizlemeCache[id] = data;                         // önbelleğe al
                popupOnizlemeBuild(data.layoutJson, data.degerler, alan);
            })
            .catch(() => {
                if (aktifPopupId === id)
                    alan.innerHTML = '<div class="text-muted text-center" style="font-size:0.82rem;">Yüklenemedi.</div>';
            });
    }

    // Popup'ı gizle
    function popupGizle() {
        hideTimeout = setTimeout(() => {
            document.getElementById('hizliOnizlePopup').style.display  = 'none';
            document.getElementById('hizliOnizleOverlay').style.display = 'none';
            aktifPopupId = null;
        }, 150); // küçük gecikme — butona tekrar gelinirse kapanmasın
    }

    // Butonlara event ekle
    document.querySelectorAll('.btn-hizli-onizle').forEach(btn => {
        btn.addEventListener('mouseenter', function () {
            popupGoster(this.dataset.id, this.dataset.sku);
        });
        btn.addEventListener('mouseleave', popupGizle);
    });

    // ── JSON Önizle ──────────────────────────────────────────────────────
    document.querySelectorAll('.btn-json-onizle').forEach(btn => {
        btn.addEventListener('click', async function () {
            aktifKampanyaId = this.dataset.id;
            const sku = this.dataset.sku;

            document.getElementById('jsonModalSku').textContent = sku;
            document.getElementById('jsonModalLoading').style.display = 'block';
            document.getElementById('jsonModalContent').style.display = 'none';
            document.getElementById('jsonModalHata').style.display    = 'none';
            document.getElementById('btnOnaylaGonder').style.display  = 'none';
            document.getElementById('gonderimDurum').style.display    = 'none';
            document.getElementById('subeTabs').innerHTML    = '';
            document.getElementById('subeTabContent').innerHTML = '';

            bootstrap.Modal.getOrCreateInstance(document.getElementById('jsonModal')).show();

            try {
                const resp = await fetch(`/Campaign/EslJsonOnizle?id=${aktifKampanyaId}`);
                const data = await resp.json();
                document.getElementById('jsonModalLoading').style.display = 'none';

                if (!data.success) {
                    document.getElementById('jsonModalHata').textContent    = data.message;
                    document.getElementById('jsonModalHata').style.display  = 'block';
                    return;
                }

                const tabs       = document.getElementById('subeTabs');
                const tabContent = document.getElementById('subeTabContent');

                data.subeler.forEach((sube, index) => {
                    const aktif  = index === 0 ? 'active' : '';
                    const show   = index === 0 ? 'show active' : '';
                    const tabId  = `tab-sube-${index}`;
                    const paneId = `pane-sube-${index}`;

                    tabs.innerHTML += `
                        <li class="nav-item" role="presentation">
                            <button class="nav-link ${aktif} px-3 py-2"
                                    id="${tabId}" data-bs-toggle="tab"
                                    data-bs-target="#${paneId}" type="button"
                                    style="font-size:0.82rem;">
                                <i class="bi bi-building me-1"></i>
                                <span class="fw-bold">${sube.storeCode}</span>
                                <span class="text-muted ms-1" style="font-size:0.75rem;">${sube.storeName}</span>
                                <span id="sonuc-${index}" class="ms-2"></span>
                            </button>
                        </li>`;

                    tabContent.innerHTML += `
                        <div class="tab-pane fade ${show} p-0" id="${paneId}" role="tabpanel">
                            <div style="position:relative;">
                                <button class="btn btn-sm btn-outline-secondary btn-kopyala"
                                        data-index="${index}"
                                        style="position:absolute; top:10px; right:10px;
                                               border-radius:8px; font-size:0.75rem; z-index:10;">
                                    <i class="bi bi-clipboard"></i> Kopyala
                                </button>
                                <pre id="json-pre-${index}"
                                     style="background:transparent; color:#d4d4d4;
                                            padding:16px; font-size:0.76rem;
                                            max-height:400px; overflow-y:auto;
                                            white-space:pre-wrap; word-break:break-all;
                                            margin:0;">${sube.json}</pre>
                            </div>
                        </div>`;
                });

                document.getElementById('jsonModalContent').style.display    = 'block';
                document.getElementById('btnOnaylaGonder').style.display = 'inline-block';

                document.querySelectorAll('.btn-kopyala').forEach(b => {
                    b.addEventListener('click', function () {
                        const idx   = this.dataset.index;
                        const metin = document.getElementById(`json-pre-${idx}`).textContent;
                        navigator.clipboard.writeText(metin).then(() => {
                            this.innerHTML = '<i class="bi bi-clipboard-check"></i> Kopyalandı!';
                            setTimeout(() => { this.innerHTML = '<i class="bi bi-clipboard"></i> Kopyala'; }, 2000);
                        });
                    });
                });
            } catch {
                document.getElementById('jsonModalLoading').style.display   = 'none';
                document.getElementById('jsonModalHata').textContent        = 'Bağlantı hatası oluştu.';
                document.getElementById('jsonModalHata').style.display      = 'block';
            }
        });
    });

    // ── Onayla ve Gönder (JSON modal içinden) ───────────────────────────
    document.getElementById('btnOnaylaGonder').addEventListener('click', async function () {
        if (!aktifKampanyaId) return;
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Gönderiliyor...';

        const durum = document.getElementById('gonderimDurum');
        durum.style.display = 'block';
        durum.innerHTML = '<span class="text-muted">Gönderim başlatıldı...</span>';

        try {
            const resp = await fetch('/Campaign/EslGonder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': antiForgeryToken
                },
                body: `id=${aktifKampanyaId}`
            });
            const data = await resp.json();

            if (data.subeSonuclari) {
                data.subeSonuclari.forEach((sonuc, index) => {
                    const el = document.getElementById(`sonuc-${index}`);
                    if (el) el.innerHTML = sonuc.basarili
                        ? '<i class="bi bi-check-circle-fill text-success"></i>'
                        : `<i class="bi bi-x-circle-fill text-danger" title="${sonuc.hata ?? ''}"></i>`;
                });
            }

            durum.innerHTML = data.success
                ? `<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>${data.message}</span>`
                : `<span class="text-danger fw-bold"><i class="bi bi-x-circle me-1"></i>${data.message}</span>`;

            toastGoster(data.message, data.success);
        } catch {
            durum.innerHTML = '<span class="text-danger">Bağlantı hatası oluştu.</span>';
            toastGoster('Bağlantı hatası oluştu.', false);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send me-1"></i>Tekrar Gönder';
        }
    });

    // ── Listeden direkt ESL Gönder ───────────────────────────────────────
    document.querySelectorAll('.btn-esl-gonder').forEach(btn => {
        btn.addEventListener('click', async function () {
            const id = this.dataset.id;
            const orijinal = this.innerHTML;
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            try {
                const resp = await fetch('/Campaign/EslGonder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: `id=${id}`
                });
                const data = await resp.json();
                toastGoster(data.message, data.success);
            } catch {
                toastGoster('Bağlantı hatası oluştu.', false);
            } finally {
                this.disabled = false;
                this.innerHTML = orijinal;
            }
        });
    });
</script>
}