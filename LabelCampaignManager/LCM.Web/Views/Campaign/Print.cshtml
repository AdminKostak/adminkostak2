@model LCM.Domain.Entities.Campaign
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Kampanya Baskı — @Model.Sku</title>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 2rem;
        }

        .print-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.1);
            width: 400px;
            overflow: hidden;
        }

   

        /* İçerik */
        .content {
            padding: 1.5rem;
        }

        .baslik {
            font-size: 1.3rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 0.2rem;
        }

        .alt-baslik {
            font-size: 0.92rem;
            color: #555;
            margin-bottom: 0.8rem;
        }

        .kampanya-notu {
            font-size: 0.82rem;
            color: #2563eb;
            background: #eff6ff;
            border-radius: 6px;
            padding: 0.4rem 0.7rem;
            margin-bottom: 0.8rem;
            display: inline-block;
        }

        .Subheadline {
            font-size: 0.82rem;
            color: #888;
            margin-bottom: 1rem;
        }

        /* Fiyat */
        .fiyat-alani {
            display: flex;
            align-items: baseline;
            gap: 1rem;
            margin-bottom: 1.2rem;
            padding: 0.8rem 1rem;
            background: #f0fdf4;
            border-radius: 10px;
        }

        .kampanya-fiyat {
            font-size: 1.8rem;
            font-weight: 700;
            color: #16a34a;
        }

        .normal-fiyat {
            font-size: 1rem;
            color: #aaa;
            text-decoration: line-through;
        }

        /* Barkod */
        .barkod-alani {
            text-align: center;
            padding-top: 1rem;
            border-top: 1px dashed #e0e0e0;
        }

            .barkod-alani svg {
                max-width: 100%;
            }

        .barkod-no {
            font-size: 0.78rem;
            color: #888;
            margin-top: 0.3rem;
            font-family: monospace;
        }

        .sku-no {
            font-size: 0.72rem;
            color: #aaa;
        }

        /* Yazdır butonu — baskıda gizlenir */
        .print-btn {
            text-align: center;
            padding: 1rem;
            border-top: 1px solid #f0f0f0;
        }

            .print-btn button {
                background: #2563eb;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 0.6rem 2rem;
                font-size: 0.9rem;
                font-weight: 600;
                cursor: pointer;
            }

                .print-btn button:hover {
                    background: #1d4ed8;
                }

        .tarih-bilgi {
            font-size: 0.75rem;
            color: #aaa;
            text-align: center;
            padding: 0.5rem 1.5rem;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .print-btn {
                display: none;
            }

            .print-card {
                box-shadow: none;
                border-radius: 0;
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="print-card">



        <!-- İçerik -->
        <div class="content">

            @if (!string.IsNullOrEmpty(Model.Baslik))
            {
                <div class="baslik">@Model.Baslik</div>
            }

            @if (!string.IsNullOrEmpty(Model.AltBaslik))
            {
                <div class="alt-baslik">@Model.AltBaslik</div>
            }

            @if (!string.IsNullOrEmpty(Model.KampanyaNotu))
            {
                <div class="kampanya-notu">
                    <i>🏷️</i> @Model.KampanyaNotu
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Subheadline))
            {
                <div class="Subheadline">@Model.Subheadline</div>
            }

            @if (Model.DiscountedPrice.HasValue || Model.OriginalPrice.HasValue)
            {
                <div class="fiyat-alani">
                    @if (Model.DiscountedPrice.HasValue)
                    {
                        <div class="kampanya-fiyat">@Model.DiscountedPrice.Value.ToString("N2") ₺</div>
                    }
                    @if (Model.OriginalPrice.HasValue)
                    {
                        <div class="normal-fiyat">@Model.OriginalPrice.Value.ToString("N2") ₺</div>
                    }
                </div>
            }

            <!-- Barkod -->
            <div class="barkod-alani">
                <svg id="barkod"></svg>
                <div class="barkod-no">@Model.Barkod</div>
                <div class="sku-no">SKU: @Model.Sku</div>
            </div>
        </div>

        <!-- Tarih Bilgisi -->
        <div class="tarih-bilgi">
            @Model.BaslangicTarihi.ToString("dd.MM.yyyy") — @Model.BitisTarihi.ToString("dd.MM.yyyy")
        </div>

        <!-- Yazdır Butonu -->
        <div class="print-btn">
            <button onclick="window.print()">
                🖨️ Yazdır
            </button>
        </div>
    </div>

    <script>
        JsBarcode("#barkod", "@Model.Barkod", {
            format: "CODE128",
            width: 2,
            height: 60,
            displayValue: false,
            margin: 0
        });
    </script>

</body>
</html>