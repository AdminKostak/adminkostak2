@model LCM.Domain.Entities.EslJob
@{
    ViewData["Title"] = "Yeni ESL Job";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">Yeni Zamanlanmış Görev</h5>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" style="font-size:0.88rem;"></div>

                    <div class="mb-3">
                        <label class="form-label fw-500" style="font-size:0.88rem;">Job Adı</label>
                        <input asp-for="JobAdi" class="form-control" style="border-radius:10px;"
                               placeholder="örn: Öğlen Gönderimi" />
                        <span asp-validation-for="JobAdi" class="text-danger" style="font-size:0.82rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-500" style="font-size:0.88rem;">Çalışma Saati</label>
                        <input asp-for="CalismaZamani" type="time" class="form-control" style="border-radius:10px;" />
                        <span asp-validation-for="CalismaZamani" class="text-danger" style="font-size:0.82rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-500" style="font-size:0.88rem;">Gönderilecek Kampanyalar</label>
                        <div class="border rounded p-3" style="border-radius:10px !important;">
                            <div class="form-check mb-2">
                                <input asp-for="AktifGonder" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" style="font-size:0.88rem;">
                                    <span class="badge rounded-pill px-2 py-1 me-1"
                                          style="background:#f0fdf4; color:#16a34a; font-size:0.75rem;">Aktif</span>
                                    kampanyalar
                                </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="PlanlanmisGonder" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" style="font-size:0.88rem;">
                                    <span class="badge rounded-pill px-2 py-1 me-1"
                                          style="background:#f0f4ff; color:#6366f1; font-size:0.75rem;">Planlanmış</span>
                                    kampanyalar
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="AktifMi" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-500" style="font-size:0.88rem;">
                                Job aktif olsun
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                        <a href="/EslJob/Index" class="btn btn-light px-4" style="border-radius:10px;">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>