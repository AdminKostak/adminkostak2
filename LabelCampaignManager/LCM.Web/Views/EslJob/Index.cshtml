@model List<LCM.Domain.Entities.EslJob>
@{
    ViewData["Title"] = "ESL Zamanlanmış Görevler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-0">ESL Zamanlanmış Görevler</h5>
        <small class="text-muted">Otomatik gönderim programlarını yönet</small>
    </div>
    <a href="/EslJob/Create" class="btn btn-primary btn-sm px-3">
        <i class="bi bi-plus-lg me-1"></i>Yeni Job
    </a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm" style="border-radius:14px;">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" style="border-radius:14px; overflow:hidden;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">JOB ADI</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">ÇALIŞMA SAATİ</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">GÖNDERİLECEKLER</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">SON ÇALIŞMA</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">DURUM</th>
                    <th class="px-4 py-3 text-muted text-end" style="font-size:0.82rem;">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model)
                {
                    <tr>
                        <td class="px-4 py-3">
                            <div style="font-size:0.9rem; font-weight:600;">@job.JobAdi</div>
                            <div style="font-size:0.75rem; color:#aaa;">
                                @job.OlusturanKullanici?.KullaniciAdi tarafından oluşturuldu
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            <span style="font-size:1rem; font-weight:700; color:#2563eb;">
                                <i class="bi bi-clock me-1"></i>@job.CalismaZamani.ToString("HH:mm")
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            @if (job.AktifGonder)
                            {
                                <span class="badge rounded-pill px-2 py-1 me-1"
                                      style="background:#f0fdf4; color:#16a34a; font-size:0.75rem;">Aktif</span>
                            }
                            @if (job.PlanlanmisGonder)
                            {
                                <span class="badge rounded-pill px-2 py-1"
                                      style="background:#f0f4ff; color:#6366f1; font-size:0.75rem;">Planlanmış</span>
                            }
                        </td>
                        <td class="px-4 py-3" style="font-size:0.82rem; color:#555;">
                            @if (job.SonCalisma.HasValue)
                            {
                                <div>@job.SonCalisma.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            else
                            {
                                <span class="text-muted">Henüz çalışmadı</span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            <form method="post" action="/EslJob/ToggleAktif/@job.Id"
                                  style="display:inline;" data-noloading="true">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="badge border-0 rounded-pill px-2 py-1"
                                        style="@(job.AktifMi ? "background:#f0fdf4; color:#16a34a;" : "background:#fef2f2; color:#dc2626;") font-size:0.78rem; cursor:pointer;">
                                    @if (job.AktifMi)
                                    {
                                        <span><i class="bi bi-check-circle me-1"></i>Aktif</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-pause-circle me-1"></i>Pasif</span>
                                    }
                                </button>
                            </form>
                        </td>
                        <td class="px-4 py-3 text-end">
                            <button type="button"
                                    class="btn btn-sm btn-outline-success me-1 btn-job-calistir"
                                    style="border-radius:8px;"
                                    data-id="@job.Id"
                                    data-adi="@job.JobAdi"
                                    title="Manuel Çalıştır">
                                <i class="bi bi-play-circle"></i>
                            </button>
                            <a href="/EslJob/Edit/@job.Id"
                               class="btn btn-sm btn-outline-primary me-1"
                               style="border-radius:8px;">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="/EslJob/Delete/@job.Id"
                                  style="display:inline;" data-noloading="true">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        onclick="openConfirm(this.closest('form'))"
                                        class="btn btn-sm btn-outline-danger"
                                        style="border-radius:8px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-clock display-6 d-block mb-2"></i>
                            Henüz zamanlanmış görev eklenmemiş.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Job Önizleme + Gönderim Modal -->
<div class="modal fade" id="jobModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:14px;">

            <div class="modal-header border-0 pb-0">
                <div>
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-play-circle me-2 text-success"></i>
                        Manuel Job Çalıştır
                    </h6>
                    <small class="text-muted">Job: <span id="jobModalAdi"></span></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body pb-0">
                <!-- Yükleniyor -->
                <div id="jobModalLoading" class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <div class="mt-2 text-muted small">Kampanyalar yükleniyor...</div>
                </div>

                <!-- Hata -->
                <div id="jobModalHata" class="alert alert-danger" style="display:none;"></div>

                <!-- Özet bilgi -->
                <div id="jobModalOzet" class="alert alert-info py-2 px-3 mb-3"
                     style="display:none; font-size:0.82rem; border-radius:10px;">
                </div>

                <!-- Tab yapısı -->
                <div id="jobModalContent" style="display:none;">
                    <ul class="nav nav-tabs" id="jobSubeTabs" role="tablist"></ul>
                    <div class="tab-content border border-top-0 rounded-bottom p-0"
                         id="jobSubeTabContent"
                         style="background:#1e1e1e; border-radius:0 0 10px 10px!important;">
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-3">
                <div id="jobGonderimDurum" class="me-auto" style="display:none; font-size:0.82rem;"></div>
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal" style="border-radius:8px;">
                    <i class="bi bi-x me-1"></i>Kapat
                </button>
                <button type="button"
                        id="btnJobOnaylaGonder"
                        class="btn btn-sm btn-success"
                        style="border-radius:8px; display:none;">
                    <i class="bi bi-send me-1"></i>Onayla ve Gönder
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
    <div id="jobToastBasari" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="jobToastBasariMesaj"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
    <div id="jobToastHata" class="toast align-items-center text-white bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="jobToastHataMesaj"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const jobAntiForgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
        let aktifJobId = null;

        // ── Toast ────────────────────────────────────────────────
        function jobToastGoster(mesaj, basarili) {
            if (basarili) {
                document.getElementById('jobToastBasariMesaj').textContent = mesaj;
                bootstrap.Toast.getOrCreateInstance(
                    document.getElementById('jobToastBasari'), { delay: 5000 }
                ).show();
            } else {
                document.getElementById('jobToastHataMesaj').textContent = mesaj;
                bootstrap.Toast.getOrCreateInstance(
                    document.getElementById('jobToastHata'), { delay: 7000 }
                ).show();
            }
        }

        // ── Çalıştır Butonu ──────────────────────────────────────
        document.querySelectorAll('.btn-job-calistir').forEach(btn => {
            btn.addEventListener('click', async function () {
                aktifJobId = this.dataset.id;
                const adi = this.dataset.adi;

                // Modal sıfırla
                document.getElementById('jobModalAdi').textContent = adi;
                document.getElementById('jobModalLoading').style.display = 'block';
                document.getElementById('jobModalContent').style.display = 'none';
                document.getElementById('jobModalHata').style.display = 'none';
                document.getElementById('jobModalOzet').style.display = 'none';
                document.getElementById('btnJobOnaylaGonder').style.display = 'none';
                document.getElementById('jobGonderimDurum').style.display = 'none';
                document.getElementById('jobSubeTabs').innerHTML = '';
                document.getElementById('jobSubeTabContent').innerHTML = '';

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('jobModal')
                ).show();

                try {
                    const resp = await fetch(`/EslJob/JobOnizle?id=${aktifJobId}`);
                    const data = await resp.json();

                    document.getElementById('jobModalLoading').style.display = 'none';

                    if (!data.success) {
                        document.getElementById('jobModalHata').textContent = data.message;
                        document.getElementById('jobModalHata').style.display = 'block';
                        return;
                    }

                    // Özet bilgi
                    const ozet = document.getElementById('jobModalOzet');
                    ozet.innerHTML = `
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>${data.toplamKampanya}</strong> kampanya,
                        <strong>${data.toplamSube}</strong> şube için JSON hazırlandı.
                        Göndermek için inceleyip onaylayın.`;
                    ozet.style.display = 'block';

                    // Tab'ları oluştur
                    const tabs = document.getElementById('jobSubeTabs');
                    const tabContent = document.getElementById('jobSubeTabContent');

                    data.subeler.forEach((sube, index) => {
                        const aktif = index === 0 ? 'active' : '';
                        const show = index === 0 ? 'show active' : '';
                        const tabId = `job-tab-sube-${index}`;
                        const paneId = `job-pane-sube-${index}`;

                        tabs.innerHTML += `
                            <li class="nav-item" role="presentation">
                                <button class="nav-link ${aktif} px-3 py-2"
                                        id="${tabId}"
                                        data-bs-toggle="tab"
                                        data-bs-target="#${paneId}"
                                        type="button"
                                        style="font-size:0.82rem;">
                                    <i class="bi bi-building me-1"></i>
                                    <span class="fw-bold">${sube.storeCode}</span>
                                    <span class="text-muted ms-1" style="font-size:0.75rem;">${sube.storeName}</span>
                                    <span class="badge bg-secondary ms-1" style="font-size:0.7rem;">
                                        ${sube.kampanyaSayisi} kampanya
                                    </span>
                                    <span id="job-sonuc-${index}" class="ms-1"></span>
                                </button>
                            </li>`;

                        tabContent.innerHTML += `
                            <div class="tab-pane fade ${show} p-0"
                                 id="${paneId}"
                                 role="tabpanel">
                                <div style="position:relative;">
                                    <button class="btn btn-sm btn-outline-secondary btn-job-kopyala"
                                            data-index="${index}"
                                            style="position:absolute; top:10px; right:10px;
                                                   border-radius:8px; font-size:0.75rem; z-index:10;">
                                        <i class="bi bi-clipboard"></i> Kopyala
                                    </button>
                                    <pre id="job-json-pre-${index}"
                                         style="background:transparent; color:#d4d4d4;
                                                padding:16px; font-size:0.76rem;
                                                max-height:400px; overflow-y:auto;
                                                white-space:pre-wrap; word-break:break-all;
                                                margin:0;">${sube.json}</pre>
                                </div>
                            </div>`;
                    });

                    document.getElementById('jobModalContent').style.display = 'block';
                    document.getElementById('btnJobOnaylaGonder').style.display = 'inline-block';

                    // Kopyala butonları
                    document.querySelectorAll('.btn-job-kopyala').forEach(b => {
                        b.addEventListener('click', function () {
                            const idx = this.dataset.index;
                            const metin = document.getElementById(`job-json-pre-${idx}`).textContent;
                            navigator.clipboard.writeText(metin).then(() => {
                                this.innerHTML = '<i class="bi bi-clipboard-check"></i> Kopyalandı!';
                                setTimeout(() => {
                                    this.innerHTML = '<i class="bi bi-clipboard"></i> Kopyala';
                                }, 2000);
                            });
                        });
                    });

                } catch (e) {
                    document.getElementById('jobModalLoading').style.display = 'none';
                    document.getElementById('jobModalHata').textContent = 'Bağlantı hatası oluştu.';
                    document.getElementById('jobModalHata').style.display = 'block';
                }
            });
        });

        // ── Onayla ve Gönder ────────────────────────────────────
        document.getElementById('btnJobOnaylaGonder').addEventListener('click', async function () {
            if (!aktifJobId) return;

            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Gönderiliyor...';

            const durum = document.getElementById('jobGonderimDurum');
            durum.style.display = 'block';
            durum.innerHTML = '<span class="text-muted">Gönderim başlatıldı...</span>';

            try {
                const resp = await fetch('/EslJob/JobCalistir', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': jobAntiForgeryToken
                    },
                    body: `id=${aktifJobId}`
                });

                const data = await resp.json();

                // Sonuçları tab'lara yaz
                if (data.subeSonuclari) {
                    data.subeSonuclari.forEach((sonuc, index) => {
                        const el = document.getElementById(`job-sonuc-${index}`);
                        if (el) {
                            el.innerHTML = sonuc.basarili
                                ? '<i class="bi bi-check-circle-fill text-success"></i>'
                                : `<i class="bi bi-x-circle-fill text-danger"
                                      title="${sonuc.hata ?? ''}"></i>`;
                        }
                    });
                }

                durum.innerHTML = data.success
                    ? `<span class="text-success fw-bold">
                           <i class="bi bi-check-circle me-1"></i>${data.message}
                       </span>`
                    : `<span class="text-danger fw-bold">
                           <i class="bi bi-x-circle me-1"></i>${data.message}
                       </span>`;

                jobToastGoster(data.message, data.success);

            } catch (e) {
                durum.innerHTML = '<span class="text-danger">Bağlantı hatası oluştu.</span>';
                jobToastGoster('Bağlantı hatası oluştu.', false);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send me-1"></i>Tekrar Gönder';
            }
        });
    </script>
}