@model List<LCM.Domain.Entities.User>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-0">Kullanıcılar</h5>
        <small class="text-muted">Sistemdeki tüm kullanıcılar</small>
    </div>
    <a href="/User/Create" class="btn btn-primary btn-sm px-3">
        <i class="bi bi-person-plus me-1"></i>Yeni Kullanıcı
    </a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm" style="border-radius:14px;">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" style="border-radius:14px; overflow:hidden;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">AD SOYAD</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">KULLANICI ADI</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">E-POSTA</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">ROL</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">DURUM</th>
                    <th class="px-4 py-3 text-muted text-end" style="font-size:0.82rem;">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4 py-3">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:34px; height:34px; border-radius:50%; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.85rem;">
                                    @item.Ad[0]@item.Soyad[0]
                                </div>
                                <div>
                                    <div style="font-size:0.9rem; font-weight:600;">@item.Ad @item.Soyad</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3" style="font-size:0.9rem;">@item.KullaniciAdi</td>
                        <td class="px-4 py-3" style="font-size:0.9rem;">@item.Email</td>
                        <td class="px-4 py-3">
                            <span class="badge rounded-pill px-3 py-2"
                                  style="background:#f0fdf4; color:#16a34a; font-size:0.82rem;">
                                @item.Rol?.RolAdi
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            @if (item.AktifMi)
                            {
                                <span class="badge rounded-pill px-3 py-2"
                                      style="background:#f0fdf4; color:#16a34a; font-size:0.82rem;">
                                    <i class="bi bi-check-circle me-1"></i>Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill px-3 py-2"
                                      style="background:#fef2f2; color:#dc2626; font-size:0.82rem;">
                                    <i class="bi bi-x-circle me-1"></i>Pasif
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3 text-end">
                            <a href="/User/Edit/@item.Id"
                               class="btn btn-sm btn-outline-primary me-1"
                               style="border-radius:8px;">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="/User/Delete/@item.Id"
                                  style="display:inline;" data-noloading="true">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        onclick="openConfirm(this.closest('form'))"
                                        class="btn btn-sm btn-outline-danger"
                                        style="border-radius:8px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-people display-6 d-block mb-2"></i>
                            Henüz kullanıcı eklenmemiş.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>