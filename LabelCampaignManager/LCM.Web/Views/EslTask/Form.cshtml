@model LCM.Web.ViewModels.EslTaskFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Görev" : "Görevi Düzenle";
    var renkler = new[] { "red", "blue", "green", "yellow", "violet", "indigo", "white" };
}

<div class="mb-4">
    <h5 class="fw-bold mb-0"><i class="bi bi-lightbulb-fill me-2 text-warning"></i>@ViewData["Title"]</h5>
    <small class="text-muted">ESL LED otomatik yakma görevi</small>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <form method="post" action="/EslTask/Kaydet">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Görev Adı</label>
                        <input asp-for="TaskName" class="form-control" placeholder="Örn: Akşam İndirimli Ürün Kontrolü" />
                        <span asp-validation-for="TaskName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mağaza</label>
                        <select asp-for="StoreId" asp-items="Model.Storeler" class="form-select">
                            <option value="">-- Mağaza Seçin --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            SQL Sorgusu
                            <span class="text-muted fw-normal small ms-1">(exec ile başlamalı, EslId ve Sku kolonları dönmeli)</span>
                        </label>
                        <textarea asp-for="SqlScript" class="form-control font-monospace" rows="3"
                                  placeholder="exec sp_GetDiscountEsls @@StoreCode = '1233'"></textarea>
                        <span asp-validation-for="SqlScript" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Cron İfadesi
                            <a href="https://crontab.guru" target="_blank" class="small ms-1">
                                <i class="bi bi-box-arrow-up-right"></i> yardım
                            </a>
                        </label>
                        <input asp-for="CronExpression" class="form-control font-monospace"
                               placeholder="0 */15 * * * *" oninput="cronAciklamaGuncelle(this.value)" />
                        <div id="cronAciklama" class="text-muted small mt-1"></div>
                        <span asp-validation-for="CronExpression" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">LED Rengi</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var renk in renkler)
                            {
                                <label class="renk-secici" style="cursor:pointer;">
                                    <input type="radio" asp-for="LedColor" value="@renk" style="display:none;"
                                           onchange="renkSecildi()" />
                                    <div class="renk-kutu @(Model.LedColor == renk ? "secili" : "")"
                                         style="width:32px;height:32px;border-radius:50%;background:@renk;
                                        border: 3px solid @(Model.LedColor == renk ? "#000" : "transparent");
                                        box-shadow: @(Model.LedColor == renk ? $"0 0 10px {renk}" : "none");">
                                    </div>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold small">LED Sayısı (0-30000)</label>
                            <input asp-for="LedCount" type="number" class="form-control" min="0" max="30000" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold small">Açık Süre (×30ms)</label>
                            <input asp-for="LedOnTime" type="number" class="form-control" min="1" max="255" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold small">Kapalı Süre (×30ms)</label>
                            <input asp-for="LedOffTime" type="number" class="form-control" min="0" max="255" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold small">Bekleme Süresi (×30ms)</label>
                            <input asp-for="LedSleepTime" type="number" class="form-control" min="0" max="255" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Görev Aktif</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1" style="border-radius:8px;">
                            <i class="bi bi-save me-2"></i>Kaydet
                        </button>
                        <a href="/EslTask" class="btn btn-outline-secondary" style="border-radius:8px;">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Sağ panel: cron yardımcı & LED önizleme -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3" style="border-radius:14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-clock me-2"></i>Hızlı Cron Seçici</h6>
                <div class="d-grid gap-2">
                    @foreach (var (etiket, deger) in new[] {
                        ("Her 15 dakikada", "0 */15 * * * *"),
                        ("Her 30 dakikada", "0 */30 * * * *"),
                        ("Her saat başı", "0 0 * * * *"),
                        ("Her gün 08:00", "0 0 8 * * *"),
                        ("Her gün 20:00", "0 0 20 * * *"),
                        ("Pazartesi-Cuma 09:00", "0 0 9 * * 1-5")
                    })
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm text-start"
                                style="border-radius:8px; font-family:monospace;"
                                onclick="cronSec('@deger')">
                            <span class="text-muted">@etiket</span>
                            <code class="ms-2">@deger</code>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb me-2"></i>LED Önizleme</h6>
                <div class="text-center py-3">
                    <div id="ledOnizleme" style="width:60px;height:60px;border-radius:50%;
                    background:red; margin:0 auto; transition: all 0.3s;
                    box-shadow: 0 0 20px red;"></div>
                    <small class="text-muted mt-2 d-block" id="ledRenkAd">Kırmızı</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // LED renk seçimi
        document.querySelectorAll('.renk-secici input').forEach(inp => {
            inp.addEventListener('change', renkSecildi);
        });

        function renkSecildi() {
            document.querySelectorAll('.renk-kutu').forEach(k => {
                k.style.border = '3px solid transparent';
                k.style.boxShadow = 'none';
            });
            const secili = document.querySelector('.renk-secici input:checked');
            if (secili) {
                const kutu = secili.nextElementSibling;
                kutu.style.border = '3px solid #000';
                kutu.style.boxShadow = `0 0 10px ${secili.value}`;
                document.getElementById('ledOnizleme').style.background = secili.value;
                document.getElementById('ledOnizleme').style.boxShadow = `0 0 20px ${secili.value}`;
                document.getElementById('ledRenkAd').textContent = secili.value;
            }
        }

        // Cron hızlı seç
        function cronSec(deger) {
            document.getElementById('CronExpression').value = deger;
            cronAciklamaGuncelle(deger);
        }

        function cronAciklamaGuncelle(val) {
            const map = {
                '0 */15 * * * *': 'Her 15 dakikada bir çalışır',
                '0 */30 * * * *': 'Her 30 dakikada bir çalışır',
                '0 0 * * * *': 'Her saat başı çalışır',
                '0 0 8 * * *': 'Her gün saat 08:00\'de çalışır',
                '0 0 20 * * *': 'Her gün saat 20:00\'de çalışır',
                '0 0 9 * * 1-5': 'Hafta içi her gün 09:00\'da çalışır'
            };
            document.getElementById('cronAciklama').textContent = map[val] || '';
        }

        // Sayfa yüklenince mevcut rengi ayarla
        renkSecildi();
    </script>
}