@model List<LCM.Web.ViewModels.EslTaskListeViewModel>
@{
    ViewData["Title"] = "ESL LED Görevleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-0"><i class="bi bi-lightbulb-fill me-2 text-warning"></i>ESL LED Görevleri</h5>
        <small class="text-muted">Otomatik LED yakma görevleri</small>
    </div>
    <a href="/EslTask/Olustur" class="btn btn-primary" style="border-radius:8px;">
        <i class="bi bi-plus-lg me-1"></i>Yeni Görev
    </a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5" style="border-radius:14px;">
        <div class="text-muted">
            <i class="bi bi-lightbulb" style="font-size:2rem;"></i>
            <p class="mt-3">Henüz görev oluşturulmamış.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var t in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm" style="border-radius:14px;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-3">
                                <!-- LED renk göstergesi -->
                                <div style="width:18px; height:18px; border-radius:50%; background:@t.LedColor; box-shadow: 0 0 8px @t.LedColor; flex-shrink:0;"></div>
                                <div>
                                    <div class="fw-bold">@t.TaskName</div>
                                    <small class="text-muted">
                                        <i class="bi bi-shop me-1"></i>@t.StoreName
                                        &nbsp;·&nbsp;
                                        <i class="bi bi-clock me-1"></i><code>@t.CronExpression</code>
                                    </small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <!-- Son çalışma durumu -->
                                @if (t.SonCalisma.HasValue)
                                {
                                    <span class="badge @(t.SonSonuc == true ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")"
                                          style="border-radius:8px;">
                                        @(t.SonSonuc == true ? "✅" : "❌") @t.SonCalisma.Value.ToString("dd.MM HH:mm")
                                    </span>
                                }
                                <!-- Aktif/Pasif toggle -->
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox"
                                    @(t.IsActive ? "checked" : "")
                                           onchange="durumDegistir(@t.Id, this)" />
                                </div>
                                <a href="/EslTask/Duzenle/@t.Id" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/EslTask/Loglar/@t.Id" class="btn btn-sm btn-outline-info" style="border-radius:8px;">
                                    <i class="bi bi-journal-text"></i> @t.ToplamLog
                                </a>
                                <button class="btn btn-sm btn-outline-danger" style="border-radius:8px;"
                                        onclick="silOnay(@t.Id, '@t.TaskName')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mt-2">
                            <code class="text-muted" style="font-size:0.78rem;">@t.SqlScript</code>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Silme formu -->
<form id="silForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        async function durumDegistir(id, el) {
            const res = await fetch(`/EslTask/DurumDegistir/${id}`, { method: 'POST' });
            if (!res.ok) el.checked = !el.checked;
        }

        function silOnay(id, ad) {
            if (confirm(`"${ad}" görevini silmek istediğinizden emin misiniz?`)) {
                const form = document.getElementById('silForm');
                form.action = `/EslTask/Sil/${id}`;
                form.submit();
            }
        }
    </script>
}