    <!-- LOADING OVERLAY -->
    <div id="loadingOverlay" style="display:none; position:fixed; inset:0; background:rgba(255,255,255,0.8); z-index:9999;">
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; border-radius:16px; padding:2rem 3rem; box-shadow:0 8px 32px rgba(0,0,0,0.15); text-align:center;">
            <div style="width:44px; height:44px; border:3px solid #e0e7ff; border-top:3px solid #2563eb; border-radius:50%; animation:lcmSpin 0.8s linear infinite; margin:0 auto 1rem;"></div>
            <div style="font-size:0.95rem; font-weight:600; color:#111;" id="loadingText">Yükleniyor...</div>
            <div style="font-size:0.82rem; color:#888; margin-top:0.3rem;" id="loadingSubText">Lütfen bekleyin</div>
        </div>
    </div>

    <!-- CONFIRM MODAL -->
    <div id="lcmConfirmModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9998;">
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; border-radius:20px; padding:2rem; width:380px; max-width:90vw; box-shadow:0 20px 60px rgba(0,0,0,0.2); text-align:center;">
            <div style="width:56px; height:56px; background:#fef2f2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; font-size:1.4rem;">🗑️</div>
            <div style="font-size:1rem; font-weight:700; color:#111; margin-bottom:0.4rem;">Emin misiniz?</div>
            <div style="font-size:0.88rem; color:#888; margin-bottom:1.5rem;">Bu işlem geri alınamaz.</div>
            <div style="display:flex; gap:0.75rem;">
                <button id="lcmCancelBtn" style="flex:1; padding:0.7rem; border:1px solid #e0e0e0; background:white; border-radius:10px; font-size:0.9rem; font-weight:500; cursor:pointer;">İptal</button>
                <button id="lcmDeleteBtn" style="flex:1; padding:0.7rem; border:none; background:#ef4444; color:white; border-radius:10px; font-size:0.9rem; font-weight:600; cursor:pointer;">Evet, Sil</button>
            </div>
        </div>
    </div>

    <style>
        @@keyframes lcmSpin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>

    <script>
        var lcmPendingForm = null;

        function showLoading(text, sub) {
            document.getElementById('loadingText').innerText = text || 'Yükleniyor...';
            document.getElementById('loadingSubText').innerText = sub || 'Lütfen bekleyin';
            document.getElementById('loadingOverlay').style.display = 'block';
        }

        function openConfirm(form) {
            lcmPendingForm = form;
            document.getElementById('lcmConfirmModal').style.display = 'block';
        }

        document.getElementById('lcmCancelBtn').onclick = function () {
            lcmPendingForm = null;
            document.getElementById('lcmConfirmModal').style.display = 'none';
        };

        document.getElementById('lcmDeleteBtn').onclick = function () {
            if (lcmPendingForm) {
                document.getElementById('lcmConfirmModal').style.display = 'none';
                showLoading('Siliniyor...', 'Kayıt kaldırılıyor');
                lcmPendingForm.submit();
            }
        };

        // Tüm formlar submit olunca loading göster (silme formları hariç)
        document.addEventListener('submit', function (e) {
            if (e.target.dataset.noloading) return;
            showLoading('İşleminiz gerçekleştiriliyor...', 'Lütfen bekleyin');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
   <script src="~/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

</body>
