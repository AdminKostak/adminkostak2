    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; }

        .navbar-custom {
            background: #ffffff;
            border-bottom: 1px solid #e0e0e0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            padding: 0.6rem 1.5rem;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.2rem;
            color: #2563eb !important;
            letter-spacing: -0.5px;
        }
        .navbar-brand span { color: #111 !important; }
        .nav-link {
            color: #555 !important;
            font-weight: 500;
            font-size: 0.92rem;
            padding: 0.5rem 0.9rem !important;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .nav-link:hover { background: #f0f2f5; color: #2563eb !important; }
        .nav-link.active { background: #eff6ff; color: #2563eb !important; }

        .dropdown-menu {
            border: 1px solid #e8e8e8;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            border-radius: 12px;
            padding: 0.4rem;
        }
        .dropdown-item {
            border-radius: 8px;
            font-size: 0.9rem;
            padding: 0.5rem 0.9rem;
        }
        .dropdown-item:hover { background: #eff6ff; color: #2563eb; }

        .user-badge {
            background: #eff6ff;
            color: #2563eb;
            border-radius: 20px;
            padding: 0.35rem 0.9rem;
            font-size: 0.88rem;
            font-weight: 600;
            border: none;
        }
        .user-badge:hover { background: #dbeafe; }

        .page-wrapper { padding: 2rem 1.5rem; }
    </style>
</head>
