@model LCM.Web.ViewModels.OperatorLogViewModel
@{
    ViewData["Title"] = "Eşleştirmelerim";
}

<div class="container-fluid px-3 py-4" style="max-width:480px;">
    <div class="d-flex align-items-center mb-4 gap-2">
        <a href="/EslEslestirme/Index" class="btn btn-light btn-sm" style="border-radius:8px;">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h5 class="fw-bold mb-0">Eşleştirmelerim</h5>
    </div>

    @if (!Model.Eslestirmeler.Any())
    {
        <div class="alert alert-info">Henüz eşleştirme yapılmamış.</div>
    }
    else
    {
        foreach (var e in Model.Eslestirmeler)
        {
            <div class="card border-0 shadow-sm mb-2" style="border-radius:14px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-bold" style="font-size:0.92rem;">@e.Kampanya.Baslik</div>
                            <div class="text-muted" style="font-size:0.82rem;">ESL: @e.EslBarkod</div>
                            <div class="text-muted" style="font-size:0.82rem;">@e.Store.StoreName — @e.IslemTipi</div>
                        </div>
                        <div class="text-end">
                            @if (e.BasariliMi)
                            {
                                <span class="badge bg-success">Başarılı</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Hatalı</span>
                            }
                            <div class="text-muted mt-1" style="font-size:0.78rem;">
                                @e.EslestirmeTarihi.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>