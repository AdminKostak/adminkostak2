        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="cokluModCheckbox" onchange="cokluModDegisti()">
            <label class="form-check-label" style="font-size:0.88rem;" for="cokluModCheckbox">
                Çoklu Etiket Eşleştirme
            </label>
        </div>

        <div id="cokluBarkodlar" class="d-none mb-3">
            <label class="form-label fw-500" style="font-size:0.88rem;">Eklenen Barkodlar</label>
            <ul id="barkodListesi" class="list-group" style="border-radius:10px;"></ul>
        </div>

        <div id="onayPopup" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
                 background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
            <div style="background:#fff; border-radius:20px; padding:32px 24px; max-width:320px;
                        width:90%; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
                <i class="bi bi-question-circle" style="font-size:2.5rem; color:#0d6efd;"></i>
                <h6 class="fw-bold mt-3 mb-2">Eşleştirmeyi Onayla</h6>
                <p class="text-muted mb-4" style="font-size:0.88rem;">Bu işlemi onaylamak istiyor musunuz?</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-success w-50" style="border-radius:10px;" onclick="eslestirOnayla()">
                        <i class="bi bi-check-lg me-1"></i>Onayla
                    </button>
                    <button class="btn btn-light w-50" style="border-radius:10px;" onclick="onayIptal()">
                        İptal
                    </button>
                </div>
            </div>
        </div>

        <div id="sonucMesaj" class="d-none mb-3"></div>

        <button class="btn btn-primary btn-lg w-100 mt-2" style="border-radius:10px;"
                onclick="eslestirBaslat()">
            <i class="bi bi-check-lg me-2"></i>Eşleştir
        </button>
    }
</div>

<script>
    var onayPopupAktif = @(ViewBag.OnayPopupAktif ? "true" : "false");
    var cokluEslestirmeIzniVar = @(ViewBag.CokluEslestirmeIzni ? "true" : "false");
    var cokluMod = false;
    var storeId = @storeId;
    var barkodlar = [];
    var aktifIndex = 0;
    var kartlar = document.querySelectorAll('.kampanya-kart');
    var toplamKart = kartlar.length;
    var touchBaslangic = 0;
    var mouseBaslangic = 0;
    var mouseBasildi = false;
    var kameraStream = null;

    function kartOnizlemeleriniYukle() {
    document.querySelectorAll('.kampanya-kart').forEach(function(kart) {
    var jsonStr = kart.getAttribute('data-layout-json');
    if (!jsonStr || jsonStr.trim() === '') return;

    var layout;
    try { layout = JSON.parse(jsonStr); } catch(e) { return; }

    var degerler = {
    Baslik:              kart.getAttribute('data-baslik') || '',
    AltBaslik:           kart.getAttribute('data-alt-baslik') || '',
    Headline:            kart.getAttribute('data-headline') || '',
    Subheadline:         kart.getAttribute('data-subheadline') || '',
    OriginalPrice:       kart.getAttribute('data-original-price') || '',
    DiscountedPrice:     kart.getAttribute('data-discounted-price') || '',
    BuyQuantityText:     kart.getAttribute('data-buy-qty') || '',
    PayQuantityText:     kart.getAttribute('data-pay-qty') || '',
    DateRange:           kart.getAttribute('data-date-range') || '',
    KampanyaNotu:        kart.getAttribute('data-kampanya-notu') || '',
    MinBasketText:       kart.getAttribute('data-min-basket') || '',
    DetailText:          kart.getAttribute('data-detail-text') || '',
    CampaignDescription: kart.getAttribute('data-campaign-desc') || '',
    OriginCountry:       kart.getAttribute('data-origin-country') || '',
    UnitPrice:           kart.getAttribute('data-unit-price') || '',
    PriceUpdateDate:     kart.getAttribute('data-price-update') || '',
    };

    var w = layout.genislik || 300;
    var h = layout.yukseklik || 400;
    var bg = layout.arkaplan || '#fff';

    var wrapperEl = kart.querySelector('.onizleme-wrapper');

    // HTML içeriğini önce oluştur
    var html = '';
    (layout.cizgiler || []).forEach(function(c) {
    var svgIc = '';
    if      (c.yon === 'yatay')    svgIc = '<line x1="0" y1="'+(c.height/2)+'" x2="'+c.width+'" y2="'+(c.height/2)+'" stroke="'+c.renk+'" stroke-width="'+c.kalinlik+'"/>';
    else if (c.yon === 'dikey')    svgIc = '<line x1="'+(c.width/2)+'" y1="0" x2="'+(c.width/2)+'" y2="'+c.height+'" stroke="'+c.renk+'" stroke-width="'+c.kalinlik+'"/>';
    else if (c.yon === 'carpraz1') svgIc = '<line x1="0" y1="0" x2="'+c.width+'" y2="'+c.height+'" stroke="'+c.renk+'" stroke-width="'+c.kalinlik+'"/>';
    else if (c.yon === 'carpraz2') svgIc = '<line x1="'+c.width+'" y1="0" x2="0" y2="'+c.height+'" stroke="'+c.renk+'" stroke-width="'+c.kalinlik+'"/>';
    html += '<div style="position:absolute;left:'+c.x+'px;top:'+c.y+'px;width:'+c.width+'px;height:'+c.height+'px;">'
    + '<svg width="'+c.width+'" height="'+c.height+'">'+svgIc+'</svg></div>';
    });

    (layout.alanlar || []).forEach(function(alan) {
    var deger = degerler[alan.ad] || '';
    var justify = alan.textAlign==='center'?'center':(alan.textAlign==='right'?'flex-end':'flex-start');

    if (alan.ad === 'IsLocalProduction') {
    html += '<div style="position:absolute;left:'+alan.x+'px;top:'+alan.y+'px;'
    + 'width:'+alan.width+'px;height:'+alan.height+'px;display:flex;align-items:center;justify-content:'+justify+';">'
    + '<img src="/img/yerliuretimkirmizi.svg" style="width:100%;height:100%;object-fit:contain;"/></div>';
    return;
    }
    if (!deger) return;

    var ef = alan.efektler || {};
    var efektSvg = '';
    if (Object.values(ef).some(function(v){ return v===true; })) {
    var renk=ef.renk||'#e63946', ek=ef.kalinlik||2;
    var pw=alan.width, ph=alan.height;
    var cw=(ef.uzunluk&&ef.uzunluk>0)?ef.uzunluk:pw;
    var ch=(ef.yukseklik&&ef.yukseklik>0)?ef.yukseklik:ph;
    var ox=(pw-cw)/2, oy=(ph-ch)/2;
    var lines='';
    if(ef.ust)      lines+='<line x1="0" y1="1" x2="'+pw+'" y2="1" stroke="'+renk+'" stroke-width="'+ek+'"/>';
    if(ef.alt)      lines+='<line x1="0" y1="'+(ph-1)+'" x2="'+pw+'" y2="'+(ph-1)+'" stroke="'+renk+'" stroke-width="'+ek+'"/>';
    if(ef.sol)      lines+='<line x1="1" y1="0" x2="1" y2="'+ph+'" stroke="'+renk+'" stroke-width="'+ek+'"/>';
    if(ef.sag)      lines+='<line x1="'+(pw-1)+'" y1="0" x2="'+(pw-1)+'" y2="'+ph+'" stroke="'+renk+'" stroke-width="'+ek+'"/>';
    if(ef.carpraz1) lines+='<line x1="'+ox+'" y1="'+oy+'" x2="'+(ox+cw)+'" y2="'+(oy+ch)+'" stroke="'+renk+'" stroke-width="'+ek+'"/>';
    if(ef.carpraz2) lines+='<line x1="'+(ox+cw)+'" y1="'+oy+'" x2="'+ox+'" y2="'+(oy+ch)+'" stroke="'+renk+'" stroke-width="'+ek+'"/>';
    efektSvg='<svg style="position:absolute;top:0;left:0;pointer-events:none;" width="'+pw+'" height="'+ph+'">'+lines+'</svg>';
    }

    var metin = (alan.ad==='OriginalPrice'||alan.ad==='DiscountedPrice') ? '₺'+deger : deger;
    html += '<div style="position:absolute;left:'+alan.x+'px;top:'+alan.y+'px;'
    + 'width:'+alan.width+'px;height:'+alan.height+'px;'
    + 'font-size:'+alan.fontSize+'px;font-weight:'+alan.fontWeight+';'
    + 'color:'+alan.color+';text-align:'+alan.textAlign+';'
    + 'display:flex;align-items:center;justify-content:'+justify+';'
    + 'overflow:hidden;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">'
    + efektSvg
    + '<span style="position:relative;z-index:1;">'+metin+'</span></div>';
    });

    var container = kart.querySelector('.onizleme-ic');
    container.style.width        = w + 'px';
    container.style.height       = h + 'px';
    container.style.background   = bg;
    container.style.borderRadius = '6px';
    container.style.overflow     = 'hidden';
    container.style.border       = '1px solid #e0e0e0';
    container.style.boxShadow    = '0 2px 12px rgba(0,0,0,0.13)';
    container.style.position     = 'relative';
    container.style.flexShrink   = '0';
    container.innerHTML          = html;

    // DOM'a yazıldıktan sonra ölç ve ortala
    setTimeout(function() {
    var totalW  = wrapperEl.offsetWidth;
    var scaleW  = (totalW - 16) / w;
    var scaleH  = 150 / h;
    var scale   = Math.min(scaleW, scaleH, 1);
    var scaledH = Math.round(h * scale);

    // transform-origin center kullanınca margin hesabı gerekmez
    container.style.transform       = 'scale(' + scale + ')';
    container.style.transformOrigin = 'top center';
    container.style.marginLeft      = '0';
    container.style.display         = 'block';

    // wrapper'ı scaled yüksekliğe göre ayarla
    wrapperEl.style.height    = (scaledH + 16) + 'px';
    wrapperEl.style.minHeight = (scaledH + 16) + 'px';
    wrapperEl.style.display   = 'flex';
    wrapperEl.style.justifyContent = 'center';
    }, 50);
    });
    }
    // Sayfa açılınca checkbox sıfırla
    document.getElementById('cokluModCheckbox').checked = false;
    document.getElementById('cokluBarkodlar').classList.add('d-none');

    var slider = document.getElementById('slider');

    slider.addEventListener('touchstart', function(e) {
        touchBaslangic = e.touches[0].clientX;
    });
    slider.addEventListener('touchend', function(e) {
        var fark = touchBaslangic - e.changedTouches[0].clientX;
        if (Math.abs(fark) > 50) {
            if (fark > 0 && aktifIndex < toplamKart - 1) sliderGit(aktifIndex + 1);
            else if (fark < 0 && aktifIndex > 0) sliderGit(aktifIndex - 1);
        }
    });
    slider.addEventListener('mousedown', function(e) {
        mouseBaslangic = e.clientX;
        mouseBasildi = true;
    });
    slider.addEventListener('mouseup', function(e) {
        if (!mouseBasildi) return;
        mouseBasildi = false;
        var fark = mouseBaslangic - e.clientX;
        if (Math.abs(fark) > 50) {
            if (fark > 0 && aktifIndex < toplamKart - 1) sliderGit(aktifIndex + 1);
            else if (fark < 0 && aktifIndex > 0) sliderGit(aktifIndex - 1);
        }
    });

    function sliderGit(index) {
        aktifIndex = index;
        slider.style.transform = 'translateX(-' + (index * 100) + '%)';
        document.getElementById('sliderSayac').innerText = (index + 1) + ' / ' + toplamKart;
        document.querySelectorAll('.nokta').forEach((n, i) => {
            n.style.background = i === index ? '#0d6efd' : '#dee2e6';
            n.style.width = i === index ? '20px' : '8px';
            n.style.borderRadius = '4px';
        });
    }

    sliderGit(0);
    window.addEventListener('load', function() { kartOnizlemeleriniYukle(); });
    function cokluModDegisti() {
        var checkbox = document.getElementById('cokluModCheckbox');
        cokluMod = checkbox.checked;
        if (cokluMod) {
            document.getElementById('cokluBarkodlar').classList.remove('d-none');
        } else {
            document.getElementById('cokluBarkodlar').classList.add('d-none');
            barkodlar = [];
            document.getElementById('barkodListesi').innerHTML = '';
        }
    }

    function barkodEkle() {
        var barkod = document.getElementById('eslBarkod').value.trim();
        if (!barkod) return;
        if (barkodlar.includes(barkod)) {
            document.getElementById('eslBarkod').value = '';
            return;
        }
        barkodlar.push(barkod);
        var li = document.createElement('li');
        li.className = 'list-group-item d-flex justify-content-between align-items-center';
        li.innerHTML = '<span><i class="bi bi-upc me-2"></i>' + barkod + '</span>' +
            '<button class="btn btn-sm btn-outline-danger" style="border-radius:6px;" onclick="barkodSil(\'' + barkod + '\', this)">Sil</button>';
        document.getElementById('barkodListesi').appendChild(li);
        document.getElementById('eslBarkod').value = '';
        document.getElementById('eslBarkod').focus();
    }

    function barkodSil(barkod, btn) {
        barkodlar = barkodlar.filter(b => b !== barkod);
        btn.closest('li').remove();
    }

    function eslestirBaslat() {
        if (cokluMod) {
            if (barkodlar.length === 0) { alert('En az bir barkod ekleyin.'); return; }
        } else {
            var barkod = document.getElementById('eslBarkod').value.trim();
            if (!barkod) { alert('ESL barkodu girin.'); return; }
            barkodlar = [barkod];
        }

        if (onayPopupAktif) {
            document.getElementById('onayPopup').style.display = 'flex';
        } else {
            eslestirGonder();
        }
    }

    function onayIptal() {
        document.getElementById('onayPopup').style.display = 'none';
    }

    function eslestirOnayla() {
        document.getElementById('onayPopup').style.display = 'none';
        eslestirGonder();
    }

    function eslestirGonder() {
        var secilenKart = kartlar[aktifIndex];
        var kampanyaId = parseInt(secilenKart.dataset.id);

        fetch('/EslEslestirme/Eslestir', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                storeId: storeId,
                kampanyaId: kampanyaId,
                eslBarkodlar: barkodlar,
                hizliMod: false
            })
        })
        .then(r => r.json())
        .then(data => {
            var el = document.getElementById('sonucMesaj');
            el.className = data.basarili ? 'alert alert-success' : 'alert alert-danger';
            el.innerText = data.mesaj;
            el.classList.remove('d-none');
            if (data.basarili) titresimVeSes(true);
            else titresimVeSes(false);
            clearTimeout(window.mesajTimer);
            window.mesajTimer = setTimeout(function() {
                el.classList.add('d-none');
            }, 3000);
            if (data.basarili) {
                document.getElementById('eslBarkod').value = '';
                barkodlar = [];
                document.getElementById('barkodListesi').innerHTML = '';
            }
        });
    }

    function kameraAc() {
        document.getElementById('kameraPanel').style.display = 'block';
        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
            .then(function(stream) {
                kameraStream = stream;
                document.getElementById('kameraVideo').srcObject = stream;
                kameraTara();
            })
            .catch(function() {
                alert('Kamera erişimi sağlanamadı.');
                document.getElementById('kameraPanel').style.display = 'none';
            });
    }

    function kameraKapat() {
        if (kameraStream) {
            kameraStream.getTracks().forEach(t => t.stop());
            kameraStream = null;
        }
        document.getElementById('kameraPanel').style.display = 'none';
    }

    function kameraTara() {
        if (!kameraStream) return;
        var video = document.getElementById('kameraVideo');
        var canvas = document.getElementById('kameraCanvas');
        var ctx = canvas.getContext('2d');

        setTimeout(function taraLoop() {
            if (!kameraStream) return;
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            if (typeof ZXing !== 'undefined') {
                var reader = new ZXing.MultiFormatReader();
                try {
                    var luminanceSource = new ZXing.HTMLCanvasElementLuminanceSource(canvas);
                    var binaryBitmap = new ZXing.BinaryBitmap(new ZXing.HybridBinarizer(luminanceSource));
                    var result = reader.decode(binaryBitmap);
                    if (result) {
                        document.getElementById('eslBarkod').value = result.getText();
                        kameraKapat();
                        return;
                    }
                } catch(e) {}
            }
            setTimeout(taraLoop, 300);
        }, 300);
    }

    document.getElementById('eslBarkod').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            if (cokluMod) {
                barkodEkle();
            } else {
                eslestirBaslat();
            }
        }
    });

    document.addEventListener('keydown', function(e) {
        var popup = document.getElementById('onayPopup');
        if (popup && popup.style.display === 'flex') {
            if (e.key === 'Enter') { e.preventDefault(); eslestirOnayla(); }
            if (e.key === 'Escape') { e.preventDefault(); onayIptal(); }
        }
    });

    document.getElementById('eslBarkod').focus();

    async function ekraniAcikTut() {
        try {
            if ('wakeLock' in navigator) {
                await navigator.wakeLock.request('screen');
            }
        } catch(e) {}
    }
    ekraniAcikTut();

    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible') ekraniAcikTut();
    });

    function titresimVeSes(basarili) {
        if ('vibrate' in navigator) {
            navigator.vibrate(basarili ? [100] : [200, 100, 200]);
        }
        var ctx = new (window.AudioContext || window.webkitAudioContext)();
        var osc = ctx.createOscillator();
        var gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        if (basarili) {
            osc.frequency.setValueAtTime(880, ctx.currentTime);
            osc.frequency.setValueAtTime(1100, ctx.currentTime + 0.1);
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.3);
        } else {
            osc.frequency.setValueAtTime(300, ctx.currentTime);
            osc.frequency.setValueAtTime(200, ctx.currentTime + 0.2);
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.4);
        }
    }
</script>