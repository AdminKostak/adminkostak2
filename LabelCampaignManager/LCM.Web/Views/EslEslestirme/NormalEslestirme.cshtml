@{
    ViewData["Title"] = "Normal Eşleştirme";
    var kampanyalar = ViewBag.Kampanyalar as List<LCM.Domain.Entities.Campaign>;
    var storeId = (int)ViewBag.StoreId;
}
<script src="https://unpkg.com/@@zxing/library@@latest/umd/index.min.js"></script>
<div class="container-fluid px-3 py-4" style="max-width:480px;">
    <div class="d-flex align-items-center mb-4 gap-2">
        <a href="/EslEslestirme/Index" class="btn btn-light btn-sm" style="border-radius:8px;">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h5 class="fw-bold mb-0">Normal Eşleştirme</h5>
    </div>

    @if (kampanyalar == null || !kampanyalar.Any())
    {
        <div class="alert alert-warning">Bu üretim yerinde aktif kampanya bulunamadı.</div>
    }
    else
    {
        <div class="mb-2 text-center text-muted" style="font-size:0.82rem;">
            <span id="sliderSayac">1 / @kampanyalar.Count</span>
        </div>

        <div style="position:relative; overflow:hidden; border-radius:16px; margin-bottom:16px;">
            <div id="slider" style="display:flex; transition: transform 0.35s cubic-bezier(.4,0,.2,1); will-change:transform;">
                @foreach (var k in kampanyalar)
                {
                    var layoutJsonStr = "";
                    if (ViewBag.KampanyaLayoutlar is Dictionary<int, string> layoutDict)
                        layoutDict.TryGetValue(k.Id, out layoutJsonStr);

                    <div class="kampanya-kart"
                         data-id="@k.Id"
                         data-baslik="@(k.Baslik ?? "")"
                         data-alt-baslik="@(k.AltBaslik ?? "")"
                         data-sku="@k.Sku"
                         data-barkod="@(k.Barkod ?? "")"
                         data-durum="@(k.Durum ?? "")"
                         data-original-price="@(k.OriginalPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                         data-discounted-price="@(k.DiscountedPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                         data-buy-qty="@(k.BuyQuantityText ?? "")"
                         data-pay-qty="@(k.PayQuantityText ?? "")"
                         data-date-range="@(k.DateRange ?? "")"
                         data-headline="@(k.Headline ?? "")"
                         data-subheadline="@(k.Subheadline ?? "")"
                         data-kampanya-notu="@(k.KampanyaNotu ?? "")"
                         data-min-basket="@(k.MinBasketText ?? "")"
                         data-detail-text="@(k.DetailText ?? "")"
                         data-campaign-desc="@(k.CampaignDescription ?? "")"
                         data-origin-country="@(k.OriginCountry ?? "")"
                         data-unit-price="@(k.UnitPrice ?? "")"
                         data-price-update="@(k.PriceUpdateDate ?? "")"
                         data-layout-json="@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(layoutJsonStr ?? ""))"
                         style="min-width:100%; border-radius:16px; padding:16px 16px 20px 16px;
                        background: linear-gradient(135deg, #f0f4ff 0%, #ffffff 100%);
                        border:2px solid #e9ecef; box-sizing:border-box;">

                        <div class="fw-bold mb-1" style="font-size:1.0rem;">@k.Baslik</div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="text-muted" style="font-size:0.82rem;"><i class="bi bi-upc me-1"></i>@k.Sku</span>
                            <span class="text-muted" style="font-size:0.82rem;"><i class="bi bi-tag me-1"></i>@k.Barkod</span>
                            <span class="badge bg-success" style="font-size:0.75rem;">@k.Durum</span>
                        </div>

                        <div class="onizleme-wrapper" style="display:flex; justify-content:center; align-items:flex-start;
                            border-radius:10px; padding:8px; min-height:60px;">
                            <div class="onizleme-ic" style="position:relative; transform-origin:top left; box-shadow: 0 2px 12px rgba(0,0,0,0.13);"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2 mb-4" id="noktalar">
            @for (int i = 0; i < kampanyalar.Count; i++)
            {
                <div class="nokta" data-index="@i"
                     onclick="sliderGit(@i)"
                     style="width:8px; height:8px; border-radius:50%; background:#dee2e6; cursor:pointer; transition: all 0.2s;"></div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label fw-500" style="font-size:0.88rem;">ESL Barkod</label>
            <input type="text" id="eslBarkod" class="form-control form-control-lg"
                   placeholder="Barkod okutun veya yazın" style="border-radius:10px;" />
        </div>
@* 
        <div class="mb-3">
            <button type="button" class="btn btn-outline-secondary w-100" style="border-radius:10px;"
                    onclick="kameraAc()">
                <i class="bi bi-camera me-1"></i>Kamera ile Tara
            </button>
        </div>

        <div id="kameraPanel" style="display:none;" class="mb-3">
            <div style="position:relative; border-radius:16px; overflow:hidden; background:#000; box-shadow:0 4px 24px rgba(0,0,0,0.3);">
                <video id="kameraVideo" style="width:100%; border-radius:16px; display:block;" autoplay playsinline></video>
                <canvas id="kameraCanvas" style="display:none;"></canvas>
                <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
                            width:220px; height:220px;
                            box-shadow: 0 0 0 9999px rgba(0,0,0,0.45);
