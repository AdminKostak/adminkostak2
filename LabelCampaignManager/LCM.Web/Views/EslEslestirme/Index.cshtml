@model LCM.Web.ViewModels.EslEslestirmeAnaSayfaViewModel
@{
    ViewData["Title"] = "ESL Eşleştirme";
}

<div class="container-fluid px-3 py-4" style="max-width:480px;">
    <h4 class="fw-bold mb-1">ESL Eşleştirme</h4>
    <p class="text-muted mb-4" style="font-size:0.88rem;">Üretim yeri ve mod seçin</p>

    @if (!Model.YetkiliStoreler.Any())
    {
        <div class="alert alert-warning">Yetkili üretim yeriniz bulunmuyor.</div>
    }
    else
    {
        foreach (var store in Model.YetkiliStoreler)
        {
            <div class="card border-0 shadow-sm mb-3" style="border-radius:14px;">
                <div class="card-body p-3">
                    <h6 class="fw-bold mb-3">@store.StoreName</h6>
                    <div class="d-grid gap-2">
                        <a href="/EslEslestirme/NormalEslestirme?storeId=@store.Id"
                           class="btn btn-primary btn-lg" style="border-radius:10px;">
                            <i class="bi bi-upc-scan me-2"></i>Normal Eşleştirme
                        </a>
                        @if (Model.HizliEslestirmeIzni)
                        {
                            <a href="/EslEslestirme/HizliEslestirme?storeId=@store.Id"
                               class="btn btn-success btn-lg" style="border-radius:10px;">
                                <i class="bi bi-lightning-fill me-2"></i>Hızlı Eşleştirme
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="mt-3">
            <a href="/EslEslestirme/Loglarim" class="btn btn-outline-secondary w-100" style="border-radius:10px;">
                <i class="bi bi-clock-history me-2"></i>Eşleştirmelerim
            </a>
        </div>
    }
</div>