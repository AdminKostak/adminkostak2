@model List<LCM.Domain.Entities.EslGonderimLog>
@{
    ViewData["Title"] = "ESL Gönderim Geçmişi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-0">ESL Gönderim Geçmişi</h5>
        <small class="text-muted">Son 200 gönderim kaydı</small>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("KampanyaYonetici"))
    {
        <button class="btn btn-primary btn-sm px-3" onclick="manuelGonderimAc()">
            <i class="bi bi-send me-1"></i>Manuel Toplu Gönder
        </button>
    }
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm" style="border-radius:14px;">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" style="border-radius:14px; overflow:hidden;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">GÖNDERİM ZAMANI</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">TETİKLEYEN</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">ŞUBE</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">KAMPANYA</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">SONUÇ</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">HTTP</th>
                    <th class="px-4 py-3 text-muted" style="font-size:0.82rem;">JSON</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="px-4 py-3">
                            <div style="font-size:0.85rem; font-weight:600;">
                                @log.GonderimZamani.ToString("dd.MM.yyyy")
                            </div>
                            <div style="font-size:0.75rem; color:#888;">
                                @log.GonderimZamani.ToString("HH:mm:ss")
                            </div>
                        </td>
                        <td class="px-4 py-3" style="font-size:0.82rem; color:#555;">
                            @if (log.Tetikleyen.StartsWith("JOB:"))
                            {
                                <span class="badge rounded-pill px-2 py-1"
                                      style="background:#fef3c7; color:#92400e; font-size:0.75rem;">
                                    <i class="bi bi-clock me-1"></i>@log.Tetikleyen
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill px-2 py-1"
                                      style="background:#eff6ff; color:#2563eb; font-size:0.75rem;">
                                    <i class="bi bi-person me-1"></i>@log.Tetikleyen
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            <span class="badge rounded-pill px-2 py-1"
                                  style="background:#f0fdf4; color:#16a34a; font-size:0.75rem;">
                                @log.StoreCode
                            </span>
                        </td>
                        <td class="px-4 py-3" style="font-size:0.82rem;">
                            <span class="text-success fw-600">@log.BasariliKampanya ✓</span>
                            @if (log.BasarisizKampanya > 0)
                            {
                                <span class="text-danger ms-2">@log.BasarisizKampanya ✗</span>
                            }
                            <span class="text-muted ms-1" style="font-size:0.75rem;">
                                / @log.ToplamKampanya toplam
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            @if (log.Basarili)
                            {
                                <span class="badge rounded-pill px-2 py-1"
                                      style="background:#f0fdf4; color:#16a34a; font-size:0.75rem;">
                                    <i class="bi bi-check-circle me-1"></i>Başarılı
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill px-2 py-1"
                                      style="background:#fef2f2; color:#dc2626; font-size:0.75rem;"
                                      title="@log.HataMesaji">
                                    <i class="bi bi-x-circle me-1"></i>Hatalı
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            <span class="badge rounded-pill px-2 py-1"
                                  style="background:#f8fafc; color:#555; font-size:0.75rem;">
                                @log.HttpStatusKod
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            @if (!string.IsNullOrEmpty(log.GonderilenJson))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning btn-json-goster"
                                        style="border-radius:8px; font-size:0.75rem;"
                                        data-logid="@log.Id"
                                        data-store="@log.StoreCode"
                                        data-zaman="@log.GonderimZamani.ToString("dd.MM.yyyy HH:mm")">
                                    <i class="bi bi-braces"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:0.75rem;">—</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-inbox display-6 d-block mb-2"></i>
                            Henüz gönderim yapılmamış.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- JSON Görüntüleme Modal -->
<div class="modal fade" id="jsonGorModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-braces me-2 text-warning"></i>
                        Gönderilen JSON
                    </h6>
                    <small class="text-muted">
                        Şube: <span id="jsonGorStore"></span> —
                        <span id="jsonGorZaman"></span>
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div style="position:relative;">
                    <button class="btn btn-sm btn-outline-secondary"
                            id="btnJsonGorKopyala"
                            style="position:absolute; top:10px; right:10px;
                                   border-radius:8px; font-size:0.75rem; z-index:10;">
                        <i class="bi bi-clipboard"></i> Kopyala
                    </button>
                    <pre id="jsonGorPre"
                         style="background:#1e1e1e; color:#d4d4d4; border-radius:10px;
                                padding:16px; font-size:0.76rem; max-height:500px;
                                overflow-y:auto; white-space:pre-wrap;
                                word-break:break-all; margin:0;"></pre>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal" style="border-radius:8px;">
                    Kapat
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Manuel Gönderim Modal -->
<div id="manuelGonderimModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
                background:white; border-radius:20px; padding:2rem; width:480px;
                max-width:90vw; box-shadow:0 20px 60px rgba(0,0,0,0.2);">

        <h6 class="fw-bold mb-1">Manuel Toplu Gönderim</h6>
        <p class="text-muted mb-3" style="font-size:0.85rem;">
            Hangi kampanyalar gönderilsin?
        </p>

        <div class="border rounded p-3 mb-3" style="border-radius:10px !important;">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chkAktif" checked />
                <label class="form-check-label" style="font-size:0.88rem;">
                    <span class="badge rounded-pill px-2 py-1 me-1"
                          style="background:#f0fdf4; color:#16a34a; font-size:0.75rem;">Aktif</span>
                    kampanyalar
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="chkPlanlanmis" />
                <label class="form-check-label" style="font-size:0.88rem;">
                    <span class="badge rounded-pill px-2 py-1 me-1"
                          style="background:#f0f4ff; color:#6366f1; font-size:0.75rem;">Planlanmış</span>
                    kampanyalar
                </label>
            </div>
        </div>

        <!-- Sonuç tablosu (gönderim sonrası görünür) -->
        <div id="gonderimSonucu" style="display:none;">
            <hr />
            <div style="font-size:0.85rem; font-weight:600; margin-bottom:0.5rem;">Gönderim Sonuçları</div>
            <div id="sonucTablosu"></div>
        </div>

        <div class="d-flex gap-2 mt-3" id="modalButonlar">
            <button class="btn btn-primary px-4" style="border-radius:10px;" onclick="manuelGonder()">
                <i class="bi bi-send me-1"></i>Gönder
            </button>
            <button class="btn btn-light px-4" style="border-radius:10px;"
                    onclick="manuelGonderimKapat()">
                İptal
            </button>
        </div>
        <div class="d-flex justify-content-end mt-3" id="kapatButonu" style="display:none !important;">
            <button class="btn btn-light px-4" style="border-radius:10px;"
                    onclick="manuelGonderimKapat()">
                Kapat
            </button>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        // ── JSON verileri — en üstte tanımla ─────────────────
        const jsonVerileri = {
            @foreach (var log in Model)
            {
                    if (!string.IsNullOrEmpty(log.GonderilenJson))
                    {
                            @:@log.Id: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(log.GonderilenJson)),
                    }
            }
        };

        // ── JSON Gör ─────────────────────────────────────────
        document.querySelectorAll('.btn-json-goster').forEach(btn => {
            btn.addEventListener('click', function () {
                const logId = this.dataset.logid;
                const store = this.dataset.store;
                const zaman = this.dataset.zaman;
                const jsonRaw = jsonVerileri[logId];

                document.getElementById('jsonGorStore').textContent = store;
                document.getElementById('jsonGorZaman').textContent = zaman;

                if (jsonRaw) {
                    try {
                        const parsed = JSON.parse(jsonRaw);
                        document.getElementById('jsonGorPre').textContent =
                            JSON.stringify(parsed, null, 2);
                    } catch {
                        document.getElementById('jsonGorPre').textContent = jsonRaw;
                    }
                } else {
                    document.getElementById('jsonGorPre').textContent = 'JSON bulunamadı.';
                }

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('jsonGorModal')
                ).show();
            });
        });

        document.getElementById('btnJsonGorKopyala').addEventListener('click', function () {
            const metin = document.getElementById('jsonGorPre').textContent;
            navigator.clipboard.writeText(metin).then(() => {
                this.innerHTML = '<i class="bi bi-clipboard-check"></i> Kopyalandı!';
                setTimeout(() => {
                    this.innerHTML = '<i class="bi bi-clipboard"></i> Kopyala';
                }, 2000);
            });
        });

        // ── Manuel Gönderim ──────────────────────────────────
        function manuelGonderimAc() {
            document.getElementById('manuelGonderimModal').style.display = 'block';
            document.getElementById('gonderimSonucu').style.display = 'none';
            document.getElementById('modalButonlar').style.display = 'flex';
            document.getElementById('kapatButonu').style.display = 'none';
        }

        function manuelGonderimKapat() {
            document.getElementById('manuelGonderimModal').style.display = 'none';
            location.reload();
        }

        async function manuelGonder() {
            var aktif = document.getElementById('chkAktif').checked;
            var planlanmis = document.getElementById('chkPlanlanmis').checked;

            if (!aktif && !planlanmis) {
                alert('En az bir durum seçiniz.');
                return;
            }

            document.getElementById('modalButonlar').innerHTML =
                '<div class="spinner-border spinner-border-sm text-primary me-2"></div> Gönderiliyor...';

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            const resp = await fetch('/EslGonderim/ManuelGonder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `aktifGonder=${aktif}&planlanmisGonder=${planlanmis}&__RequestVerificationToken=${token}`
            });

            const data = await resp.json();

            var html = '<table class="table table-sm mb-0" style="font-size:0.82rem;">';
            html += '<thead><tr><th>Şube</th><th>Kampanya</th><th>Sonuç</th></tr></thead><tbody>';

            if (data.sonuclar && data.sonuclar.length > 0) {
                data.sonuclar.forEach(s => {
                    var renk = s.basarili ? '#16a34a' : '#dc2626';
                    var icon = s.basarili ? '✓' : '✗';
                    html += `<tr>
                        <td><span class="badge rounded-pill px-2" style="background:#f0fdf4; color:#16a34a;">${s.storeCode || '—'}</span></td>
                        <td>${s.toplamKampanya} kampanya</td>
                        <td style="color:${renk}; font-weight:600;">${icon} ${s.basarili ? 'Başarılı' : (s.hataMesaji ?? 'Hatalı')}</td>
                    </tr>`;
                });
            } else {
                html += '<tr><td colspan="3" class="text-muted text-center">Sonuç bulunamadı.</td></tr>';
            }

            html += '</tbody></table>';

            document.getElementById('sonucTablosu').innerHTML = html;
            document.getElementById('gonderimSonucu').style.display = 'block';
            document.getElementById('modalButonlar').style.display = 'none';
            document.getElementById('kapatButonu').style.display = 'flex';
        }
    </script>
}