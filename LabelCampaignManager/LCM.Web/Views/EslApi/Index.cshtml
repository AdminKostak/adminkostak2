@model LCM.Domain.Entities.EslApiSetting
@{
    ViewData["Title"] = "ESL API Ayarları";
    var ayar = Model ?? new LCM.Domain.Entities.EslApiSetting();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-0"><i class="bi bi-plug-fill me-2 text-primary"></i>ESL API Ayarları</h5>
        <small class="text-muted">PrisMART entegrasyon bağlantı ayarları ve test paneli</small>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">


    <div class="col-lg-5">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-gear me-2"></i>Bağlantı Ayarları</h6>
                <form method="post" action="/EslApi/Kaydet">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">API URL</label>
                        <input type="text" name="apiUrl" class="form-control"
                               value="@ayar.ApiUrl" placeholder="http://192.168.1.1:8080/prismart/integration" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Access Key</label>
                        <input type="text" name="accessKey" class="form-control"
                               value="@ayar.AccessKey" placeholder="access_key değeri" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Secret Key</label>
                        <div class="input-group">
                            <input type="password" name="secretKey" id="secretKeyInput"
                                   class="form-control" placeholder="@(string.IsNullOrEmpty(ayar?.SecretKey) ? "Secret key girin" : "••••••••  (değiştirmek için yeni değer girin)")" />
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="toggleSecret()">
                                <i class="bi bi-eye" id="secretEye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Customer Store Code</label>
                        <input type="text" name="customerStoreCode" class="form-control"
                               value="@ayar.CustomerStoreCode" placeholder="Mağaza kodu" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Algorithm</label>
                            <input type="text" name="algorithm" class="form-control"
                                   value="@ayar.Algorithm" placeholder="HS256" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Header Prefix</label>
                            <input type="text" name="headerPrefix" class="form-control"
                                   value="@ayar.HeaderPrefix" placeholder="HSIAM1" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"
                            style="border-radius:8px;">
                        <i class="bi bi-save me-2"></i>Ayarları Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>

    
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-1"><i class="bi bi-send me-2"></i>API Test Paneli</h6>
                <p class="text-muted mb-3" style="font-size:0.85rem;">
                    JSON gövdesini girin ve kayıtlı ayarlarla gönderin.
                    <code>date</code> ve <code>Authorization</code> header'ları otomatik oluşturulur.
                </p>

                <div class="mb-3">
                    <label class="form-label fw-semibold">JSON Gövdesi</label>
                    <textarea id="jsonBody" class="form-control font-monospace"
                              rows="8" style="font-size:0.85rem; resize:vertical;"
                              placeholder='Json verisi'></textarea>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-success flex-grow-1" onclick="testGonder()"
                            style="border-radius:8px;" id="gonderBtn">
                        <i class="bi bi-send-fill me-2"></i>Gönder
                    </button>
                    <button class="btn btn-outline-secondary" onclick="temizle()"
                            style="border-radius:8px;">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>

                <div id="sonucPanel" style="display:none;">
                    <hr />
                    <h6 class="fw-bold mb-3">Sonuç</h6>

                    <div class="row g-2 mb-3">
                        <div class="col-auto">
                            <span class="badge px-3 py-2" id="statusBadge"
                                  style="font-size:0.85rem; border-radius:8px;">—</span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:0.8rem;">
                            Gönderilen Date Header
                        </label>
                        <div class="bg-light rounded p-2 font-monospace"
                             style="font-size:0.82rem;" id="gonderilenDate">
                            —
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:0.8rem;">
                            Payload
                        </label>
                        <pre id="gonderilenPayload"
                             class="bg-light rounded p-2 font-monospace"
                             style="font-size:0.82rem; max-height:180px; overflow-y:auto;"></pre>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:0.8rem;">
                            Authorization Header
                        </label>
                        <div class="bg-light rounded p-2 font-monospace"
                             style="font-size:0.82rem; word-break:break-all;" id="gonderilenAuth">
                            —
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold" style="font-size:0.8rem;">
                            API Yanıtı
                        </label>
                        <pre id="yanitIcerigi"
                             class="bg-dark text-light rounded p-3"
                             style="font-size:0.82rem; max-height:200px; overflow-y:auto; border-radius:10px !important;">—</pre>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSecret() {
            const inp = document.getElementById('secretKeyInput');
            const eye = document.getElementById('secretEye');
            if (inp.type === 'password') {
                inp.type = 'text';
                eye.className = 'bi bi-eye-slash';
            } else {
                inp.type = 'password';
                eye.className = 'bi bi-eye';
            }
        }

        function temizle() {
            document.getElementById('jsonBody').value = '';
            document.getElementById('sonucPanel').style.display = 'none';
        }

        async function testGonder() {

            const jsonBody = document.getElementById('jsonBody').value.trim();
            if (!jsonBody) {
                alert('Lütfen JSON gövdesini girin.');
                return;
            }

            // JSON geçerlilik kontrolü
            try { JSON.parse(jsonBody); }
            catch (e) { alert('Geçersiz JSON formatı: ' + e.message); return; }

                 // ← BUNU EKLE: her gönderimde sıfırla
        document.getElementById('sonucPanel').style.display = 'none';
        document.getElementById('statusBadge').textContent = '—';
        document.getElementById('gonderilenDate').textContent = '—';
        document.getElementById('gonderilenAuth').textContent = '—';
        document.getElementById('yanitIcerigi').textContent = '—';
        document.getElementById('gonderilenPayload').textContent = '—';

            const btn = document.getElementById('gonderBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Gönderiliyor...';

            try {
                const response = await fetch('/EslApi/TestGonder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ jsonBody: jsonBody })
                });

                const sonuc = await response.json();

                document.getElementById('sonucPanel').style.display = 'block';
                document.getElementById('gonderilenDate').textContent = sonuc.gonderilenDate || '—';
                document.getElementById('gonderilenAuth').textContent = sonuc.gonderilenAuth || '—';
                document.getElementById('gonderilenPayload').textContent = sonuc.gonderilenPayload || '—';


                // Yanıtı formatla
                let yanitText = sonuc.yanitIcerigi || '—';
                try { yanitText = JSON.stringify(JSON.parse(yanitText), null, 2); } catch {}
                document.getElementById('yanitIcerigi').textContent = yanitText;

                // Status badge
                const badge = document.getElementById('statusBadge');
                if (sonuc.basarili) {
                    badge.textContent = '✅ ' + sonuc.statusKod + ' Başarılı';
                    badge.style.background = '#f0fdf4';
                    badge.style.color = '#16a34a';
                } else {
                    badge.textContent = '❌ ' + (sonuc.statusKod || 'Hata') + ' Başarısız';
                    badge.style.background = '#fef2f2';
                    badge.style.color = '#dc2626';
                }

            } catch (e) {
                alert('İstek gönderilemedi: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Gönder';
            }
        }
    </script>
}