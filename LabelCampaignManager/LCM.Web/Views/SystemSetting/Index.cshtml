@model List<LCM.Domain.Entities.SystemSetting>
@{
    ViewData["Title"] = "Sistem Ayarları";
    var smtp = ViewBag.SmtpSetting as LCM.Domain.Entities.SmtpSetting;
}

<style>
    .ss-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #f0f4f8;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        padding: 1.25rem 1.5rem;
        transition: box-shadow .2s;
    }
    .ss-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.08); }

    .ss-toggle {
        position: relative; display: inline-block;
        width: 44px; height: 24px; flex-shrink: 0;
    }
    .ss-toggle input { opacity: 0; width: 0; height: 0; }
    .ss-slider {
        position: absolute; cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background: #e2e8f0; border-radius: 24px;
        transition: .3s;
    }
    .ss-slider:before {
        position: absolute; content: "";
        height: 18px; width: 18px; left: 3px; bottom: 3px;
        background: white; border-radius: 50%; transition: .3s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }
    .ss-toggle input:checked + .ss-slider { background: #2563eb; }
    .ss-toggle input:checked + .ss-slider:before { transform: translateX(20px); }

    .ss-icon {
        width: 40px; height: 40px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; flex-shrink: 0;
    }

    .ss-section-title {
        font-size: 0.72rem; font-weight: 600; color: #94a3b8;
        letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 0.75rem;
    }
</style>

@* Başlık *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-0">Sistem Ayarları</h5>
        <small class="text-muted">Özellik açma/kapama ve entegrasyon ayarları</small>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" style="border-radius:12px;">
        <i class="bi bi-check-circle me-2"></i>@TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Özellik Ayarları *@
<div class="ss-section-title"><i class="bi bi-toggles me-1"></i>Özellik Ayarları</div>
<div class="row g-3 mb-4">
    @foreach (var item in Model)
    {
        var (ikon, ikonBg, ikonRenk) = item.AyarAdi switch
        {
            "KampanyaEkleCaptcha"       => ("bi-shield-check",        "#eff6ff", "#2563eb"),
            "SablonEkleCaptcha"         => ("bi-shield-lock",         "#f0f4ff", "#6366f1"),
            "KullaniciEkleCaptcha"      => ("bi-person-lock",         "#fdf4ff", "#9333ea"),
            "EslOnayPopupAktif"         => ("bi-ui-checks-grid",      "#fff7ed", "#ea580c"),
            "EslOverrideAktif"          => ("bi-arrow-repeat",        "#fffbeb", "#d97706"),
            "DashboardOtomatikGuncelleme"=>("bi-speedometer2",        "#f0fdf4", "#16a34a"),
            "KampanyaOnayaGonderilsinMi"=> ("bi-patch-check",         "#f0fdf4", "#16a34a"),
            "MailBildirimleriAktif"     => ("bi-envelope-check",      "#eff6ff", "#2563eb"),
            "OnayMailiGonderilsinMi"    => ("bi-envelope-arrow-up",   "#f0fdf4", "#16a34a"),
            _                          => ("bi-gear",                 "#f8fafc", "#64748b")
        };

        <div class="col-md-4 col-lg-3">
            <div class="ss-card h-100">
                <div class="d-flex align-items-start gap-3">
                    @* İkon *@
                    <div class="ss-icon" style="background:@ikonBg; color:@ikonRenk;">
                        <i class="bi @ikon"></i>
                    </div>
                    @* Yazı + Toggle *@
                    <div style="flex:1; min-width:0;">
                        <div style="font-size:0.85rem; font-weight:600; color:#111; margin-bottom:2px;">
                            @AyarAdiGoster(item.AyarAdi)
                        </div>
                        <div style="font-size:0.73rem; color:#94a3b8; margin-bottom:0.75rem; line-height:1.4;">
                            @AyarAciklamasi(item.AyarAdi)
                        </div>
                        @* Toggle form *@
                        <form method="post" action="/SystemSetting/Guncelle/@item.Id"
                              data-noloading="true"
                              style="display:flex; align-items:center; gap:0.6rem;">
                            @Html.AntiForgeryToken()
                            <label class="ss-toggle">
                                <input type="checkbox"
                                       @(item.AktifMi ? "checked" : "")
                                       onchange="this.form.submit()" />
                                <span class="ss-slider"></span>
                            </label>
                            <span style="font-size:0.78rem; font-weight:500;
                                         color:@(item.AktifMi ? "#16a34a" : "#94a3b8");">
                                @(item.AktifMi ? "Aktif" : "Pasif")
                            </span>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* SMTP Ayarları *@
<div class="ss-section-title"><i class="bi bi-envelope-gear me-1"></i>SMTP Mail Ayarları</div>
<div class="ss-card">
    <p class="text-muted mb-4" style="font-size:0.82rem;">
        Mail bildirimlerinin çalışması için SMTP sunucu bilgilerini girin.
    </p>
    <form method="post" action="/SystemSetting/SmtpGuncelle">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label" style="font-size:0.8rem; color:#555;">SMTP Sunucu</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-radius:10px 0 0 10px; background:#f8fafc;">
                        <i class="bi bi-hdd-network text-muted"></i>
                    </span>
                    <input type="text" name="host" class="form-control"
                           style="border-radius:0 10px 10px 0;"
                           value="@(smtp?.Host ?? "")" placeholder="smtp.gmail.com" />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label" style="font-size:0.8rem; color:#555;">Port</label>
                <input type="number" name="port" class="form-control"
                       style="border-radius:10px;"
                       value="@(smtp?.Port ?? 587)" />
            </div>
            <div class="col-md-5">
                <label class="form-label" style="font-size:0.8rem; color:#555;">Kullanıcı Adı</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-radius:10px 0 0 10px; background:#f8fafc;">
                        <i class="bi bi-person text-muted"></i>
                    </span>
                    <input type="text" name="kullaniciAdi" class="form-control"
                           style="border-radius:0 10px 10px 0;"
                           value="@(smtp?.KullaniciAdi ?? "")" placeholder="ornek@gmail.com" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:0.8rem; color:#555;">Şifre</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-radius:10px 0 0 10px; background:#f8fafc;">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input type="password" name="sifre" class="form-control"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="Değiştirmek için girin" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:0.8rem; color:#555;">Gönderen Adı</label>
                <input type="text" name="gonderenAdi" class="form-control"
                       style="border-radius:10px;"
                       value="@(smtp?.GonderenAdi ?? "LCM Sistem")" />
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:0.8rem; color:#555;">Gönderen E-posta</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-radius:10px 0 0 10px; background:#f8fafc;">
                        <i class="bi bi-at text-muted"></i>
                    </span>
                    <input type="email" name="gonderenEmail" class="form-control"
                           style="border-radius:0 10px 10px 0;"
                           value="@(smtp?.GonderenEmail ?? "")" placeholder="ornek@gmail.com" />
                </div>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input type="checkbox" name="sslAktif" value="true"
                           class="form-check-input" id="sslAktif"
                           @(smtp?.SslAktif == true ? "checked" : "") />
                    <label class="form-check-label" for="sslAktif" style="font-size:0.82rem;">
                        SSL/TLS Aktif
                    </label>
                </div>
            </div>
        </div>

        @* Kaydet + Test *@
        <div class="d-flex flex-wrap gap-2 align-items-center mt-4 pt-3"
             style="border-top:1px solid #f0f4f8;">
            <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;">
                <i class="bi bi-check-lg me-1"></i>Kaydet
            </button>
            <div class="d-flex gap-2 align-items-center ms-2">
                <div class="input-group" style="width:240px;">
                    <span class="input-group-text" style="border-radius:10px 0 0 10px; background:#f8fafc;">
                        <i class="bi bi-envelope text-muted" style="font-size:0.85rem;"></i>
                    </span>
                    <input type="email" id="testMailAdresi" class="form-control form-control-sm"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="Test mail adresi" />
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                        style="border-radius:10px;" onclick="smtpTest()">
                    <i class="bi bi-send me-1"></i>Test
                </button>
                <span id="testSonuc" style="font-size:0.8rem;"></span>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function smtpTest() {
            var email = document.getElementById('testMailAdresi').value;
            if (!email) { alert('Test mail adresi girin.'); return; }

            var sonuc = document.getElementById('testSonuc');
            sonuc.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Gönderiliyor...';
            sonuc.style.color = '#64748b';

            fetch('/SystemSetting/SmtpTest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector(
                        'input[name="__RequestVerificationToken"]').value
                },
                body: 'hedefEmail=' + encodeURIComponent(email)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                sonuc.innerHTML = (d.ok ? '✅ ' : '❌ ') + d.mesaj;
                sonuc.style.color = d.ok ? '#16a34a' : '#dc2626';
            })
            .catch(function() {
                sonuc.innerHTML = '❌ Bağlantı hatası.';
                sonuc.style.color = '#dc2626';
            });
        }
    </script>
}

@functions {
    string AyarAdiGoster(string ayarAdi) => ayarAdi switch
    {
        "KampanyaEkleCaptcha"        => "Kampanya Ekle — Captcha",
        "SablonEkleCaptcha"          => "Şablon Ekle — Captcha",
        "KullaniciEkleCaptcha"       => "Kullanıcı Ekle — Captcha",
        "EslOnayPopupAktif"          => "ESL Onay Popup",
        "EslOverrideAktif"           => "ESL Override",
        "DashboardOtomatikGuncelleme"=> "Dashboard Otomatik Güncelleme",
        "KampanyaOnayaGonderilsinMi" => "Kampanya Onay Süreci",
        "MailBildirimleriAktif"      => "Mail Bildirimleri",
        "OnayMailiGonderilsinMi"     => "Onay Sürecinde Mail Gönder",
        _ => ayarAdi
    };

    string AyarAciklamasi(string ayarAdi) => ayarAdi switch
    {
        "KampanyaEkleCaptcha"        => "Kampanya oluşturmada captcha doğrulaması",
        "SablonEkleCaptcha"          => "Şablon oluşturmada captcha doğrulaması",
        "KullaniciEkleCaptcha"       => "Kullanıcı oluşturmada captcha doğrulaması",
        "EslOnayPopupAktif"          => "ESL eşleştirmede onay popup göster",
        "EslOverrideAktif"           => "Mevcut eşleşmenin üzerine yazılabilir",
        "DashboardOtomatikGuncelleme"=> "Dashboard açılınca tarihe göre statü güncelle",
        "KampanyaOnayaGonderilsinMi" => "VeriGirisi kullanıcısı kampanyayı onaya göndersin",
        "MailBildirimleriAktif"      => "Sistem genelinde mail gönderimi aktif/pasif",
        "OnayMailiGonderilsinMi"     => "Onay sürecinde ilgili kişilere mail gönder",
        _ => ""
    };
}