@{
    ViewData["Title"] = "Bağlantı Hatası";
}

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height:60vh;">
    <div class="card border-0 shadow-sm text-center p-5" style="border-radius:16px; max-width:420px;">
        <i class="bi bi-wifi-off display-3 text-danger mb-3"></i>
        <h4 class="fw-bold mb-2">Sunucuya Bağlanılamıyor</h4>
        <p class="text-muted mb-4" style="font-size:0.92rem;">
            Veritabanı sunucusuna erişilemiyor. Lütfen ağ bağlantınızı kontrol edin ve tekrar deneyin.
        </p>
        <a href="/" class="btn btn-primary px-4" style="border-radius:10px;">
            <i class="bi bi-arrow-clockwise me-1"></i>Tekrar Dene
        </a>
    </div>
</div>