@model List<LCM.Domain.Entities.Template>
@{
    ViewData["Title"] = "Alan Eşleştirme";
}

<h4 class="mb-3">Alan Eşleştirme — Şablon Seç</h4>

@if (!Model.Any())
{
    <div class="alert alert-warning">Henüz şablon eklenmemiş.</div>
}
else
{
    <div class="row">
        @foreach (var s in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">@s.SablonAdi</h6>
                        <span class="badge bg-info text-dark">@s.EtiketTip.EtiketTipi</span>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Manage" asp-route-sablonId="@s.Id"
                           class="btn btn-primary btn-sm w-100">
                            Eşleştir
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}