@model LCM.Web.ViewModels.FieldMappingViewModel
@using LCM.Web
@{
    ViewData["Title"] = "Alan Eşleştirme";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div>
        <h5 class="mb-0">@Model.SablonAdi</h5>
        <span class="badge bg-info text-dark">@Model.EtiketTipi</span>
    </div>
    <a asp-action="Index" class="btn btn-secondary btn-sm ms-auto">← Geri</a>
    <button id="btnKaydet" class="btn btn-success btn-sm">Kaydet</button>
</div>

@if (!Model.EslAlanlari.Any())
{
    <div class="alert alert-warning">
        Önce <a asp-controller="EslField" asp-action="Index">ESL Alanları</a> ekleyin.
    </div>
    return;
}

<!-- ESL Alanları (sürüklenebilir kartlar) -->
<div class="card mb-4" style="position: sticky; top: 60px; z-index: 100;">
    <div class="card-header fw-bold bg-dark text-white">ESL Alanları — Sürükle</div>
    <div class="card-body d-flex flex-wrap gap-2" id="eslHavuz" style="max-height: 160px; overflow-y: auto;">
        @foreach (var esl in Model.EslAlanlari)
        {
            var kullanimdaMi = Model.MevcutEslesmeler.Any(m => m.EslFieldId == esl.Id);
            if (!kullanimdaMi)
            {
                <div class="esl-kart badge-esl"
                     draggable="true"
                     data-id="@esl.Id"
                     data-name="@esl.VariableName"
                     data-type="@esl.DataType">
                    <strong>@esl.VariableName</strong>
                    <small class="d-block text-muted">@esl.DataType</small>
                </div>
            }
        }
    </div>
</div>

<!-- Eşleştirme tablosu -->
<div class="card">
    <div class="card-header fw-bold bg-secondary text-white">Eşleştirmeler</div>
    <table class="table table-bordered mb-0" id="eslesmeTablosu">
        <thead class="table-light">
            <tr>
                <th style="width:40%">DB Alanlar</th>
                <th>ESL Karşılığı</th>
                <th style="width:80px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alan in Model.MevcutEslesmeler)
            {
                <tr data-alan="@alan.BizimAlanAdi">
                    <td>
                        <span class="fw-bold">@alan.BizimAlanAdi</span>
                        <small class="d-block text-muted">@AlanAdlari.GetTurkce(alan.BizimAlanAdi)</small>
                    </td>
                    <td class="drop-hedef"
                        data-esl-id="@alan.EslFieldId"
                        data-esl-name="@alan.EslVariableName">
                        @if (alan.EslFieldId.HasValue)
                        {
                            <div class="esl-kart esl-kart-placed"
                                 data-id="@alan.EslFieldId"
                                 data-name="@alan.EslVariableName">
                                <strong>@alan.EslVariableName</strong>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic drop-placeholder">← buraya bırak</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (alan.EslFieldId.HasValue)
                        {
                            <button class="btn btn-outline-danger btn-sm btnKaldir"
                                    data-alan="@alan.BizimAlanAdi">
                                ✕
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .esl-kart {
        background: #0d6efd;
        color: white;
        border-radius: 8px;
        padding: 8px 14px;
        cursor: grab;
        user-select: none;
        min-width: 100px;
        text-align: center;
    }

        .esl-kart small {
            color: #cfe2ff !important;
        }

    .esl-kart-placed {
        background: #198754;
        cursor: default;
        display: inline-block;
    }

    .drop-hedef {
        min-height: 42px;
        border-radius: 6px;
        transition: background 0.2s;
    }

        .drop-hedef.dragover {
            background: #cfe2ff;
        }

    .drop-placeholder {
        font-size: 0.85rem;
    }
</style>
<!-- Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="basariToast" class="toast align-items-center text-white border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastMesaj"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>
<script>
        function showToast(mesaj, tip) {
        const toast = document.getElementById('basariToast');
        const toastMesaj = document.getElementById('toastMesaj');
        toast.classList.remove('bg-success', 'bg-danger', 'bg-warning');
        toast.classList.add(tip === 'success' ? 'bg-success' : tip === 'danger' ? 'bg-danger' : 'bg-warning');
        toastMesaj.textContent = mesaj;
        const bsToast = new bootstrap.Toast(toast, { delay: 3000 });
        bsToast.show();
    }
    // Sürükleme başlangıcı
    document.addEventListener('dragstart', function (e) {
        const kart = e.target.closest('.esl-kart');
        if (!kart || kart.classList.contains('esl-kart-placed')) {
            e.preventDefault();
            return;
        }
        e.dataTransfer.setData('eslId', kart.dataset.id);
        e.dataTransfer.setData('eslName', kart.dataset.name);
        e.dataTransfer.setData('eslType', kart.dataset.type || '');
    });

    // Bırakma alanı hazırla
    document.querySelectorAll('.drop-hedef').forEach(hedef => {
        hedef.addEventListener('dragover', e => {
            e.preventDefault();
            hedef.classList.add('dragover');
        });
        hedef.addEventListener('dragleave', () => {
            hedef.classList.remove('dragover');
        });
        hedef.addEventListener('drop', function (e) {
            e.preventDefault();
            hedef.classList.remove('dragover');

            const eslId = e.dataTransfer.getData('eslId');
            const eslName = e.dataTransfer.getData('eslName');
            const eslType = e.dataTransfer.getData('eslType');

            // Zaten dolu mu?
            if (hedef.dataset.eslId) return;

            // Havuzdan kaldır
            const havuzdakiKart = document.querySelector(`#eslHavuz [data-id="${eslId}"]`);
            if (havuzdakiKart) havuzdakiKart.remove();

            // Placeholder kaldır
            const placeholder = hedef.querySelector('.drop-placeholder');
            if (placeholder) placeholder.remove();

            // Kart ekle
            const yeniKart = document.createElement('div');
            yeniKart.className = 'esl-kart esl-kart-placed';
            yeniKart.dataset.id = eslId;
            yeniKart.dataset.name = eslName;
            yeniKart.innerHTML = `<strong>${eslName}</strong><small class="d-block" style="color:#a3cfbb">${eslType}</small>`;
            hedef.appendChild(yeniKart);

            hedef.dataset.eslId = eslId;
            hedef.dataset.eslName = eslName;

            // Kaldır butonu göster
            const satir = hedef.closest('tr');
            const td = satir.querySelector('td:last-child');
            td.innerHTML = `<button class="btn btn-outline-danger btn-sm btnKaldir"
                data-alan="${satir.dataset.alan}">✕</button>`;
            td.querySelector('.btnKaldir').addEventListener('click', kaldirHandler);
        });
    });

    // Kaldır butonu
    function kaldirHandler(e) {
        const alanAdi = e.target.dataset.alan;
        const satir = document.querySelector(`tr[data-alan="${alanAdi}"]`);
        const hedef = satir.querySelector('.drop-hedef');

        const eslId = hedef.dataset.eslId;
        const eslName = hedef.dataset.eslName;

        // Havuza geri ekle
        const geriKart = document.createElement('div');
        geriKart.className = 'esl-kart badge-esl';
        geriKart.draggable = true;
        geriKart.dataset.id = eslId;
        geriKart.dataset.name = eslName;
        geriKart.innerHTML = `<strong>${eslName}</strong>`;
        document.getElementById('eslHavuz').appendChild(geriKart);

        // Hücreyi temizle
        hedef.dataset.eslId = '';
        hedef.dataset.eslName = '';
        hedef.innerHTML = '<span class="text-muted fst-italic drop-placeholder">← buraya bırak</span>';

        // Kaldır butonunu gizle
        e.target.closest('td').innerHTML = '';
    }

    document.querySelectorAll('.btnKaldir').forEach(btn => {
        btn.addEventListener('click', kaldirHandler);
    });

    // Kaydet
    document.getElementById('btnKaydet').addEventListener('click', async function () {
        const eslesmeler = [];
        document.querySelectorAll('#eslesmeTablosu tbody tr').forEach(satir => {
            const alanAdi = satir.dataset.alan;
            const hedef = satir.querySelector('.drop-hedef');
            const eslId = hedef.dataset.eslId ? parseInt(hedef.dataset.eslId) : null;
            eslesmeler.push({ bizimAlanAdi: alanAdi, eslFieldId: eslId });
        });

        const response = await fetch('/FieldMapping/Save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                sablonId: @Model.SablonId,
                eslesmeler: eslesmeler
            })
        });

        const result = await response.json();
            if (result.basari) {
        showToast('Eşleştirmeler başarıyla kaydedildi.', 'success');
    }
    });
</script>